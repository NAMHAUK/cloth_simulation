#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Positions {
    vec4 positions[];
};

layout(std430, binding = 1) readonly buffer Indices {
    uint indices[];
};

layout(std430, binding = 2) writeonly buffer TriangleNormals {
    vec4 triangle_normals[];
};

uniform uint uTriangleCount;

vec4 triangle_normal(vec3 p0, vec3 p1, vec3 p2)
{
    vec3 normal = cross(p1 - p0, p2 - p0);
    float normal_length_sq = dot(normal, normal);
    float inv_normal_length = normal_length_sq > 1.0e-20 ? inversesqrt(normal_length_sq) : 0.0;
    float normal_length = inv_normal_length > 0.0 ? 1.0 / inv_normal_length : 0.0;
    return vec4(inv_normal_length > 0.0 ? normal * inv_normal_length : vec3(0.0), normal_length);
}

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uint index_base = triangle_index * 3u;
    uint i0 = indices[index_base];
    uint i1 = indices[index_base + 1u];
    uint i2 = indices[index_base + 2u];

    vec3 p0 = positions[i0].xyz;
    vec3 p1 = positions[i1].xyz;
    vec3 p2 = positions[i2].xyz;

    triangle_normals[triangle_index] = triangle_normal(p0, p1, p2);
}
