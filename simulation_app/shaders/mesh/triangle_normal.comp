#version 430 core

#include "../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer Positions {
    vec4 positions[];
};

layout(std430, binding = CLOTH_TRIANGLE_VERTEX_INDICES) readonly buffer Indices {
    uint triangle_indices[];
};

layout(std430, binding = CLOTH_TRIANGLE_NORMALS) writeonly buffer TriangleNormals {
    vec4 triangle_normals[];
};

uniform uint uTriangleCount;

#define POSITION_IO_TRIANGLE_INDICES
#include "position_io.glsl"

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uvec3 vertex_indices = read_triangle_indices(triangle_index);
    vec3 p0 = positions[vertex_indices.x].xyz;
    vec3 p1 = positions[vertex_indices.y].xyz;
    vec3 p2 = positions[vertex_indices.z].xyz;

    triangle_normals[triangle_index] = triangle_normal(p0, p1, p2);
}
