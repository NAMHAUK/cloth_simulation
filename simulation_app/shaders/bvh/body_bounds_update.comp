#version 430 core

#include "../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

#include "bvh.glsl"

const float max_float = 3.402823e+38;

#include "../mesh/primitive_geometry.glsl"

layout(std430, binding = BODY_TRIANGLE_POSITIONS) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

layout(std430, binding = CHARACTER_TRIANGLE_INDICES) readonly buffer BodyTriangleIndices {
    uint triangle_indices[];
};

layout(std430, binding = CHARACTER_CURRENT_POSITIONS) readonly buffer BodyCurrentPositions {
    vec4 body_current_positions[];
};

layout(std430, binding = CHARACTER_PREVIOUS_POSITIONS) readonly buffer BodyPreviousPositions {
    vec4 body_previous_positions[];
};

layout(std430, binding = BODY_TRIANGLE_BVH_NODES) buffer BodyTriangleBvhNodes {
    BvhNode body_triangle_bvh_nodes[];
};

layout(std430, binding = BODY_TRIANGLE_BOUNDS) buffer BodyTriangleBounds {
    Aabb body_triangle_bounds[];
};

layout(std430, binding = BODY_BVH_VERTEX_INDICES) readonly buffer BodyVertexIndices {
    uint body_vertex_indices[];
};

layout(std430, binding = BODY_VERTEX_BVH_NODES) buffer BodyVertexBvhNodes {
    BvhNode body_vertex_bvh_nodes[];
};

layout(std430, binding = BODY_VERTEX_BOUNDS) buffer BodyVertexBounds {
    Aabb body_vertex_bounds[];
};

layout(std430, binding = BODY_EDGE_INDICES) readonly buffer BodyEdgeIndices {
    uint body_edge_indices[];
};

layout(std430, binding = BODY_EDGE_BVH_NODES) buffer BodyEdgeBvhNodes {
    BvhNode body_edge_bvh_nodes[];
};

layout(std430, binding = BODY_EDGE_BOUNDS) buffer BodyEdgeBounds {
    Aabb body_edge_bounds[];
};

uniform uint uTriangleFirstNodeIndex;
uniform uint uTriangleNodeCount;
uniform uint uVertexFirstNodeIndex;
uniform uint uVertexNodeCount;
uniform uint uEdgeFirstNodeIndex;
uniform uint uEdgeNodeCount;
uniform float uDetectionDistance;

#define POSITION_IO_BODY_CURRENT
#define POSITION_IO_BODY_PREVIOUS
#include "../mesh/position_io.glsl"

void update_triangle_leaf_bounds(uint node_index, BvhNode node)
{
    vec3 min_bounds = vec3(max_float);
    vec3 max_bounds = vec3(-max_float);
    for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
        uint triangle_index = node.first_element_index + triangle_offset;
        TrianglePositions triangle = body_triangle_positions[triangle_index];
        if (body_triangle_normals[triangle_index].w == 0.0) {
            body_triangle_bounds[triangle_index] = Aabb(vec4(vec3(max_float), 0.0),
                                                        vec4(vec3(-max_float), 0.0));
            continue;
        }

        uint index_base = triangle_index * 3u;
        vec3 previous_a = read_body_previous_position(triangle_indices[index_base]);
        vec3 previous_b = read_body_previous_position(triangle_indices[index_base + 1u]);
        vec3 previous_c = read_body_previous_position(triangle_indices[index_base + 2u]);

        vec3 current_a = triangle.a;
        vec3 current_b = triangle.b;
        vec3 current_c = triangle.c;

        vec3 current_min_bounds = min(current_a, min(current_b, current_c));
        vec3 current_max_bounds = max(current_a, max(current_b, current_c));
        vec3 swept_min_bounds = min(min(previous_a, min(previous_b, previous_c)), current_min_bounds);
        vec3 swept_max_bounds = max(max(previous_a, max(previous_b, previous_c)), current_max_bounds);
        body_triangle_bounds[triangle_index].min_bounds = vec4(swept_min_bounds - uDetectionDistance, 0.0);
        body_triangle_bounds[triangle_index].max_bounds = vec4(swept_max_bounds + uDetectionDistance, 0.0);
        min_bounds = min(min_bounds, swept_min_bounds);
        max_bounds = max(max_bounds, swept_max_bounds);
    }

    body_triangle_bvh_nodes[node_index].bounds = Aabb(vec4(min_bounds - uDetectionDistance, 0.0),
                                                      vec4(max_bounds + uDetectionDistance, 0.0));
}

void update_triangle_internal_bounds(uint node_index, BvhNode node)
{
    vec4 min_bounds = min(body_triangle_bvh_nodes[node.left_child_index].bounds.min_bounds,
                          body_triangle_bvh_nodes[node.right_child_index].bounds.min_bounds);
    vec4 max_bounds = max(body_triangle_bvh_nodes[node.left_child_index].bounds.max_bounds,
                          body_triangle_bvh_nodes[node.right_child_index].bounds.max_bounds);

    body_triangle_bvh_nodes[node_index].bounds = Aabb(min_bounds, max_bounds);
}

void update_vertex_leaf_bounds(uint node_index, BvhNode node)
{
    vec3 min_bounds = vec3(max_float);
    vec3 max_bounds = vec3(-max_float);
    for (uint vertex_offset = 0u; vertex_offset < node.element_count; ++vertex_offset) {
        uint vertex_index = body_vertex_indices[node.first_element_index + vertex_offset];
        vec3 previous_position = read_body_previous_position(vertex_index);
        vec3 current_position = read_body_current_position(vertex_index);
        vec3 vertex_min_bounds = min(previous_position, current_position);
        vec3 vertex_max_bounds = max(previous_position, current_position);
        body_vertex_bounds[vertex_index].min_bounds = vec4(vertex_min_bounds - uDetectionDistance, 0.0);
        body_vertex_bounds[vertex_index].max_bounds = vec4(vertex_max_bounds + uDetectionDistance, 0.0);
        min_bounds = min(min_bounds, vertex_min_bounds);
        max_bounds = max(max_bounds, vertex_max_bounds);
    }

    body_vertex_bvh_nodes[node_index].bounds = Aabb(vec4(min_bounds - uDetectionDistance, 0.0),
                                                    vec4(max_bounds + uDetectionDistance, 0.0));
}

void update_vertex_internal_bounds(uint node_index, BvhNode node)
{
    vec4 min_bounds = min(body_vertex_bvh_nodes[node.left_child_index].bounds.min_bounds,
                          body_vertex_bvh_nodes[node.right_child_index].bounds.min_bounds);
    vec4 max_bounds = max(body_vertex_bvh_nodes[node.left_child_index].bounds.max_bounds,
                          body_vertex_bvh_nodes[node.right_child_index].bounds.max_bounds);

    body_vertex_bvh_nodes[node_index].bounds = Aabb(min_bounds, max_bounds);
}

void update_edge_leaf_bounds(uint node_index, BvhNode node)
{
    vec3 min_bounds = vec3(max_float);
    vec3 max_bounds = vec3(-max_float);
    for (uint edge_offset = 0u; edge_offset < node.element_count; ++edge_offset) {
        uint edge_index = node.first_element_index + edge_offset;
        uint edge_base = edge_index * 2u;
        uint vertex_a = body_edge_indices[edge_base];
        uint vertex_b = body_edge_indices[edge_base + 1u];
        vec3 previous_a = read_body_previous_position(vertex_a);
        vec3 previous_b = read_body_previous_position(vertex_b);
        vec3 current_a = read_body_current_position(vertex_a);
        vec3 current_b = read_body_current_position(vertex_b);
        vec3 edge_min_bounds = min(min(previous_a, previous_b), min(current_a, current_b));
        vec3 edge_max_bounds = max(max(previous_a, previous_b), max(current_a, current_b));
        body_edge_bounds[edge_index].min_bounds = vec4(edge_min_bounds - uDetectionDistance, 0.0);
        body_edge_bounds[edge_index].max_bounds = vec4(edge_max_bounds + uDetectionDistance, 0.0);
        min_bounds = min(min_bounds, edge_min_bounds);
        max_bounds = max(max_bounds, edge_max_bounds);
    }

    body_edge_bvh_nodes[node_index].bounds =
        Aabb(vec4(min_bounds - uDetectionDistance, 0.0),
             vec4(max_bounds + uDetectionDistance, 0.0));
}

void update_edge_internal_bounds(uint node_index, BvhNode node)
{
    vec4 min_bounds = min(body_edge_bvh_nodes[node.left_child_index].bounds.min_bounds,
                          body_edge_bvh_nodes[node.right_child_index].bounds.min_bounds);
    vec4 max_bounds = max(body_edge_bvh_nodes[node.left_child_index].bounds.max_bounds,
                          body_edge_bvh_nodes[node.right_child_index].bounds.max_bounds);

    body_edge_bvh_nodes[node_index].bounds = Aabb(min_bounds, max_bounds);
}

void update_triangle_bounds(uint local_node_index)
{
    uint node_index = uTriangleFirstNodeIndex + local_node_index;
    BvhNode node = body_triangle_bvh_nodes[node_index];
    if (is_leaf_node(node)) {
        update_triangle_leaf_bounds(node_index, node);
    } else {
        update_triangle_internal_bounds(node_index, node);
    }
}

void update_vertex_bounds(uint local_node_index)
{
    uint node_index = uVertexFirstNodeIndex + local_node_index;
    BvhNode node = body_vertex_bvh_nodes[node_index];
    if (is_leaf_node(node)) {
        update_vertex_leaf_bounds(node_index, node);
    } else {
        update_vertex_internal_bounds(node_index, node);
    }
}

void update_edge_bounds(uint local_node_index)
{
    uint node_index = uEdgeFirstNodeIndex + local_node_index;
    BvhNode node = body_edge_bvh_nodes[node_index];
    if (is_leaf_node(node)) {
        update_edge_leaf_bounds(node_index, node);
    } else {
        update_edge_internal_bounds(node_index, node);
    }
}

void main()
{
    uint local_node_index = gl_GlobalInvocationID.x;
    if (local_node_index < uTriangleNodeCount) {
        update_triangle_bounds(local_node_index);
    }
    if (local_node_index < uVertexNodeCount) {
        update_vertex_bounds(local_node_index);
    }
    if (local_node_index < uEdgeNodeCount) {
        update_edge_bounds(local_node_index);
    }
}
