#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct MeshBvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_triangle_index;
    uint triangle_count;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer MeshBvhNodeBuffer {
    MeshBvhNode bvh_nodes[];
};

uniform uint uRootNodeIndex;

#include "character_collision_common.glsl"

uniform uint uClothVertexCount;
uniform float uCollisionThickness;

const float triangle_edge_tolerance = -1.0e-6;
const float collision_slop = 0.0005;
const float max_final_correction_length = 0.01;

bool point_inside_triangle(vec3 point, vec3 a, vec3 b, vec3 c, vec3 normal)
{
    vec3 ab = b - a;
    vec3 bc = c - b;
    vec3 ca = a - c;
    return dot(cross(ab, point - a), normal) >= triangle_edge_tolerance &&
           dot(cross(bc, point - b), normal) >= triangle_edge_tolerance &&
           dot(cross(ca, point - c), normal) >= triangle_edge_tolerance;
}

bool evaluate_planar_vertex_triangle_contact(vec3 previous_position,
                                             vec3 current_position,
                                             uint triangle_index,
                                             out vec3 correction_normal,
                                             out float correction_depth)
{
    correction_normal = vec3(0.0, 1.0, 0.0);
    correction_depth = 0.0;

    vec4 stored_normal = triangle_geometry[triangle_index].normal;
    if (stored_normal.w == 0.0) {
        return false;
    }

    vec3 a = triangle_geometry[triangle_index].a.xyz;
    vec3 b = triangle_geometry[triangle_index].b.xyz;
    vec3 c = triangle_geometry[triangle_index].c.xyz;
    vec3 normal = stored_normal.xyz;

    float previous_signed_distance = dot(previous_position - a, normal);
    float current_signed_distance = dot(current_position - a, normal);
    if (previous_signed_distance >= uCollisionThickness &&
        current_signed_distance >= uCollisionThickness) {
        return false;
    }

    bool has_contact = false;
    if (previous_signed_distance > uCollisionThickness &&
        current_signed_distance < uCollisionThickness) {
        float denominator = current_signed_distance - previous_signed_distance;
        float t = (uCollisionThickness - previous_signed_distance) / denominator;
        if (t >= 0.0 && t <= 1.0) {
            vec3 hit_position = mix(previous_position, current_position, t);
            vec3 surface_position = hit_position - normal * uCollisionThickness;
            if (point_inside_triangle(surface_position, a, b, c, normal)) {
                correction_normal = normal;
                correction_depth = max(uCollisionThickness - current_signed_distance - collision_slop, 0.0);
                has_contact = correction_depth > 0.0;
            }
        }
    }

    if (current_signed_distance < uCollisionThickness) {
        vec3 surface_position = current_position - normal * current_signed_distance;
        if (point_inside_triangle(surface_position, a, b, c, normal)) {
            float contact_depth = max(uCollisionThickness - current_signed_distance - collision_slop, 0.0);
            if (contact_depth > correction_depth) {
                correction_normal = normal;
                correction_depth = contact_depth;
                has_contact = true;
            }
        }
    }

    return has_contact;
}

void main()
{
    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    if (cloth_vertex_index >= uClothVertexCount) {
        return;
    }

    uint cloth_vertex_base_index = cloth_vertex_index * 3u;
    vec3 previous_position = vec3(previous_positions[cloth_vertex_base_index],
                                  previous_positions[cloth_vertex_base_index + 1u],
                                  previous_positions[cloth_vertex_base_index + 2u]);
    vec3 current_position = vec3(current_positions[cloth_vertex_base_index],
                                 current_positions[cloth_vertex_base_index + 1u],
                                 current_positions[cloth_vertex_base_index + 2u]);
    Aabb query_bounds = build_swept_aabb(previous_position, current_position);

    vec3 accumulated_correction = vec3(0.0);
    uint contact_count = 0u;

    uint node_index_stack[max_bvh_stack_depth];
    uint stack_count = 0u;

    node_index_stack[stack_count] = uRootNodeIndex;
    ++stack_count;

    while (stack_count > 0u) {
        --stack_count;
        uint current_node_index = node_index_stack[stack_count];
        MeshBvhNode current_node = bvh_nodes[current_node_index];
        if (!overlaps_bounds(query_bounds, current_node)) {
            continue;
        }

        if (is_leaf_node(current_node)) {
            for (uint triangle_offset = 0u; triangle_offset < current_node.triangle_count; ++triangle_offset) {
                vec3 correction_normal;
                float correction_depth;
                if (evaluate_planar_vertex_triangle_contact(previous_position,
                                                            current_position,
                                                            current_node.first_triangle_index + triangle_offset,
                                                            correction_normal,
                                                            correction_depth)) {
                    accumulated_correction += correction_normal * correction_depth;
                    ++contact_count;
                }
            }
        } else {
            node_index_stack[stack_count] = current_node.left_child_index;
            ++stack_count;
            node_index_stack[stack_count] = current_node.right_child_index;
            ++stack_count;
        }
    }

    if (contact_count == 0u) {
        return;
    }

    vec3 final_correction = accumulated_correction / float(contact_count);
    float correction_length_sq = dot(final_correction, final_correction);
    float max_correction_length_sq = max_final_correction_length * max_final_correction_length;
    if (correction_length_sq > max_correction_length_sq) {
        final_correction *= max_final_correction_length * inversesqrt(correction_length_sq);
    }

    vec3 corrected_position = current_position + final_correction;
    vec3 corrected_previous_position = previous_position + final_correction;
    current_positions[cloth_vertex_base_index] = corrected_position.x;
    current_positions[cloth_vertex_base_index + 1u] = corrected_position.y;
    current_positions[cloth_vertex_base_index + 2u] = corrected_position.z;
    previous_positions[cloth_vertex_base_index] = corrected_previous_position.x;
    previous_positions[cloth_vertex_base_index + 1u] = corrected_previous_position.y;
    previous_positions[cloth_vertex_base_index + 2u] = corrected_previous_position.z;
}
