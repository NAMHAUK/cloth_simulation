#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct MeshBvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child;
    uint right_child;
    uint first_triangle;
    uint triangle_count;
};

bool is_leaf_node(MeshBvhNode node)
{
    return node.triangle_count > 0u;
}

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer MeshBvhNodeBuffer {
    MeshBvhNode bvh_nodes[];
};

uniform uint uClothVertexCount;
uniform uint uBvhNodeCount;
uniform uint uRootNodeIndex;
uniform float uSearchRadiusSquared;
uniform float uCollisionThickness;

const uint max_bvh_stack_depth = 32u;

float length_squared(vec3 value)
{
    return dot(value, value);
}

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    current_positions[base] = position.x;
    current_positions[base + 1u] = position.y;
    current_positions[base + 2u] = position.z;
    previous_positions[base] = position.x;
    previous_positions[base + 1u] = position.y;
    previous_positions[base + 2u] = position.z;
}

float squared_distance_to_bounds(vec3 point, vec3 min_bounds, vec3 max_bounds)
{
    vec3 clamped_point = clamp(point, min_bounds, max_bounds);
    return length_squared(point - clamped_point);
}

vec3 closest_point_on_triangle(vec3 point, vec3 a, vec3 b, vec3 c, vec3 ab, vec3 ac)
{
    vec3 ap = point - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return a;
    }

    vec3 bp = point - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return b;
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        return a + v * ab;
    }

    vec3 cp = point - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return c;
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        return a + w * ac;
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + w * (ac - ab);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return a + ab * v + ac * w;
}

void test_character_triangle(uint triangle_index,
                             vec3 cloth_position,
                             inout vec3 best_closest_point,
                             inout vec3 best_normal,
                             inout float best_distance_sq,
                             inout bool has_candidate)
{
    vec4 normal = triangle_geometry[triangle_index].normal;
    if (normal.w == 0.0) {
        return;
    }

    vec3 a = triangle_geometry[triangle_index].a.xyz;
    vec3 b = triangle_geometry[triangle_index].b.xyz;
    vec3 c = triangle_geometry[triangle_index].c.xyz;
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 unit_normal = normal.xyz;

    float plane_distance = dot(cloth_position - a, unit_normal);
    if (plane_distance * plane_distance > best_distance_sq) {
        return;
    }

    vec3 closest_point = closest_point_on_triangle(cloth_position, a, b, c, ab, ac);
    vec3 offset = cloth_position - closest_point;
    float distance_sq = length_squared(offset);

    if (distance_sq <= best_distance_sq) {
        best_distance_sq = distance_sq;
        best_closest_point = closest_point;
        best_normal = unit_normal;
        has_candidate = true;
    }
}

void main()
{
    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    if (cloth_vertex_index >= uClothVertexCount) {
        return;
    }

    vec3 cloth_position = load_cloth_position(cloth_vertex_index);
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = uSearchRadiusSquared;
    bool has_candidate = false;

    uint node_stack[32];
    float node_distance_stack[32];
    uint stack_count = 0u;
    uint node_index = uRootNodeIndex;
    float node_distance_sq = 0.0;
    if (node_index < uBvhNodeCount) {
        MeshBvhNode root_node = bvh_nodes[node_index];
        node_distance_sq = squared_distance_to_bounds(cloth_position, root_node.min_bounds.xyz, root_node.max_bounds.xyz);
    }

    while (node_index < uBvhNodeCount) {
        if (node_distance_sq > best_distance_sq) {
            if (stack_count == 0u) {
                break;
            }
            --stack_count;
            node_index = node_stack[stack_count];
            node_distance_sq = node_distance_stack[stack_count];
            continue;
        }

        MeshBvhNode node = bvh_nodes[node_index];
        if (is_leaf_node(node)) {
            uint first_triangle = node.first_triangle;
            uint triangle_count = node.triangle_count;
            for (uint triangle_offset = 0u; triangle_offset < triangle_count; ++triangle_offset) {
                test_character_triangle(first_triangle + triangle_offset,
                                        cloth_position,
                                        best_closest_point,
                                        best_normal,
                                        best_distance_sq,
                                        has_candidate);
            }
            if (stack_count == 0u) {
                break;
            }
            --stack_count;
            node_index = node_stack[stack_count];
            node_distance_sq = node_distance_stack[stack_count];
            continue;
        }

        uint left_child = node.left_child;
        uint right_child = node.right_child;
        bool has_left_child = left_child < uBvhNodeCount;
        bool has_right_child = right_child < uBvhNodeCount;
        if (has_left_child && has_right_child) {
            MeshBvhNode left_node = bvh_nodes[left_child];
            MeshBvhNode right_node = bvh_nodes[right_child];
            float left_distance_sq = squared_distance_to_bounds(cloth_position, left_node.min_bounds.xyz, left_node.max_bounds.xyz);
            float right_distance_sq = squared_distance_to_bounds(cloth_position, right_node.min_bounds.xyz, right_node.max_bounds.xyz);
            uint visit_child = left_distance_sq <= right_distance_sq ? left_child : right_child;
            uint deferred_child = left_distance_sq <= right_distance_sq ? right_child : left_child;
            float visit_distance_sq = min(left_distance_sq, right_distance_sq);
            float deferred_distance_sq = max(left_distance_sq, right_distance_sq);

            if (deferred_distance_sq <= best_distance_sq && stack_count < max_bvh_stack_depth) {
                node_stack[stack_count] = deferred_child;
                node_distance_stack[stack_count] = deferred_distance_sq;
                ++stack_count;
            }

            if (visit_distance_sq <= best_distance_sq) {
                node_index = visit_child;
                node_distance_sq = visit_distance_sq;
                continue;
            }
        } else if (has_left_child || has_right_child) {
            uint child = has_left_child ? left_child : right_child;
            MeshBvhNode child_node = bvh_nodes[child];
            float child_distance_sq = squared_distance_to_bounds(cloth_position, child_node.min_bounds.xyz, child_node.max_bounds.xyz);
            if (child_distance_sq <= best_distance_sq) {
                node_index = child;
                node_distance_sq = child_distance_sq;
                continue;
            }
        }

        if (stack_count == 0u) {
            break;
        }
        --stack_count;
        node_index = node_stack[stack_count];
        node_distance_sq = node_distance_stack[stack_count];
    }

    if (!has_candidate) {
        return;
    }

    float signed_distance = dot(cloth_position - best_closest_point, best_normal);
    if (signed_distance < uCollisionThickness) {
        store_cloth_position(cloth_vertex_index, best_closest_point + best_normal * uCollisionThickness);
    }
}
