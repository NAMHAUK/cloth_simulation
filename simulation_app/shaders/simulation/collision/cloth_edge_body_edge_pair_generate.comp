#version 430 core

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = 3) readonly buffer BodyEdgeIndices {
    uint body_edge_indices[];
};

layout(std430, binding = 4) readonly buffer BvhNodes {
    BvhNode body_edge_bvh_nodes[];
};

layout(std430, binding = 5) readonly buffer BodyCurrentPositions {
    float body_current_positions[];
};

layout(std430, binding = 6) readonly buffer BodyPreviousPositions {
    float body_previous_positions[];
};

layout(std430, binding = 7) buffer PairRecords {
    uvec2 pair_records[];
};

layout(std430, binding = 8) buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 9) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uEdgeCount;
uniform uint uMaxPairCount;
uniform float uCollisionThickness;
uniform uint uIgnoredBodyPartMask;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;

struct Aabb {
    vec3 min_bounds;
    vec3 max_bounds;
};

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

bool is_ignored_body_part_node(BvhNode node)
{
    uint part_label_mask = uint(node.max_bounds.w + 0.5);
    return part_label_mask != 0u && (part_label_mask & ~uIgnoredBodyPartMask) == 0u;
}

vec3 read_cloth_current_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(cloth_current_positions[base_index],
                cloth_current_positions[base_index + 1u],
                cloth_current_positions[base_index + 2u]);
}

vec3 read_cloth_previous_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(cloth_previous_positions[base_index],
                cloth_previous_positions[base_index + 1u],
                cloth_previous_positions[base_index + 2u]);
}

vec3 read_body_current_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(body_current_positions[base_index],
                body_current_positions[base_index + 1u],
                body_current_positions[base_index + 2u]);
}

vec3 read_body_previous_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(body_previous_positions[base_index],
                body_previous_positions[base_index + 1u],
                body_previous_positions[base_index + 2u]);
}

Aabb build_cloth_edge_swept_aabb(uint cloth_edge_id)
{
    uint edge_base = cloth_edge_id * 2u;
    uint vertex_a = cloth_edge_indices[edge_base];
    uint vertex_b = cloth_edge_indices[edge_base + 1u];

    vec3 previous_a = read_cloth_previous_position(vertex_a);
    vec3 previous_b = read_cloth_previous_position(vertex_b);
    vec3 current_a = read_cloth_current_position(vertex_a);
    vec3 current_b = read_cloth_current_position(vertex_b);

    vec3 min_bounds = min(min(previous_a, previous_b), min(current_a, current_b));
    vec3 max_bounds = max(max(previous_a, previous_b), max(current_a, current_b));
    return Aabb(min_bounds, max_bounds);
}

Aabb build_body_edge_swept_aabb(uint body_edge_id)
{
    uint edge_base = body_edge_id * 2u;
    uint vertex_a = body_edge_indices[edge_base];
    uint vertex_b = body_edge_indices[edge_base + 1u];

    vec3 previous_a = read_body_previous_position(vertex_a);
    vec3 previous_b = read_body_previous_position(vertex_b);
    vec3 current_a = read_body_current_position(vertex_a);
    vec3 current_b = read_body_current_position(vertex_b);
    vec3 expansion = vec3(uCollisionThickness);

    vec3 min_bounds = min(min(previous_a, previous_b), min(current_a, current_b)) - expansion;
    vec3 max_bounds = max(max(previous_a, previous_b), max(current_a, current_b)) + expansion;
    return Aabb(min_bounds, max_bounds);
}

bool overlaps_aabb(Aabb left_bounds, vec3 right_min_bounds, vec3 right_max_bounds)
{
    return all(lessThanEqual(left_bounds.min_bounds, right_max_bounds)) &&
           all(greaterThanEqual(left_bounds.max_bounds, right_min_bounds));
}

void append_pair(uint cloth_edge_id, uint body_edge_id)
{
    uint pair_index = atomicAdd(pair_count, 1u);
    if (pair_index >= uMaxPairCount) {
        atomicAdd(overflow_count, 1u);
        return;
    }

    pair_records[pair_index] = uvec2(cloth_edge_id, body_edge_id);
}

void main()
{
    uint cloth_edge_id = gl_GlobalInvocationID.x;
    if (cloth_edge_id >= uEdgeCount) {
        return;
    }

    Aabb cloth_swept_bounds = build_cloth_edge_swept_aabb(cloth_edge_id);

    uint node_index_stack[max_bvh_stack_depth];
    uint stack_count = 0u;
    node_index_stack[stack_count++] = bvh_root_node;

    while (stack_count > 0u) {
        --stack_count;
        BvhNode current_node = body_edge_bvh_nodes[node_index_stack[stack_count]];
        if (is_ignored_body_part_node(current_node)) {
            continue;
        }

        if (!overlaps_aabb(cloth_swept_bounds, current_node.min_bounds.xyz, current_node.max_bounds.xyz)) {
            continue;
        }

        if (is_leaf_node(current_node)) {
            for (uint edge_offset = 0u; edge_offset < current_node.element_count; ++edge_offset) {
                uint body_edge_id = current_node.first_element_index + edge_offset;
                Aabb body_bounds = build_body_edge_swept_aabb(body_edge_id);
                if (overlaps_aabb(cloth_swept_bounds, body_bounds.min_bounds, body_bounds.max_bounds)) {
                    append_pair(cloth_edge_id, body_edge_id);
                }
            }
        } else {
            node_index_stack[stack_count++] = current_node.left_child_index;
            node_index_stack[stack_count++] = current_node.right_child_index;
        }
    }
}
