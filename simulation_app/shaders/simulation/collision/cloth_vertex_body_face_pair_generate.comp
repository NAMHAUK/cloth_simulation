#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 4) buffer PairRecords {
    uvec2 pair_records[];
};

layout(std430, binding = 5) buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 6) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uClothVertexCount;
uniform uint uMaxPairCount;
uniform float uCollisionThickness;
uniform uint uIgnoredBodyPartMask;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;
const uint group_pair_capacity = 512u;

shared uvec2 group_pairs[group_pair_capacity];
shared uint group_pair_count;
shared uint group_base_index;

struct Aabb {
    vec3 min_bounds;
    vec3 max_bounds;
};

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

bool is_ignored_body_part_node(BvhNode node)
{
    uint part_label_mask = uint(node.max_bounds.w + 0.5);
    return part_label_mask != 0u && (part_label_mask & ~uIgnoredBodyPartMask) == 0u;
}

vec3 read_cloth_current_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(cloth_current_positions[base_index],
                cloth_current_positions[base_index + 1u],
                cloth_current_positions[base_index + 2u]);
}

vec3 read_cloth_previous_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(cloth_previous_positions[base_index],
                cloth_previous_positions[base_index + 1u],
                cloth_previous_positions[base_index + 2u]);
}

Aabb build_swept_vertex_aabb(vec3 previous_position, vec3 current_position)
{
    return Aabb(min(previous_position, current_position),
                max(previous_position, current_position));
}

Aabb build_body_triangle_aabb(uint triangle_index)
{
    CharacterTriangleGeometry triangle = triangle_geometry[triangle_index];
    vec3 min_bounds = min(triangle.a.xyz, min(triangle.b.xyz, triangle.c.xyz));
    vec3 max_bounds = max(triangle.a.xyz, max(triangle.b.xyz, triangle.c.xyz));
    vec3 expansion = vec3(uCollisionThickness);
    return Aabb(min_bounds - expansion, max_bounds + expansion);
}

bool overlaps_aabb(Aabb left_bounds, vec3 right_min_bounds, vec3 right_max_bounds)
{
    return all(lessThanEqual(left_bounds.min_bounds, right_max_bounds)) &&
           all(greaterThanEqual(left_bounds.max_bounds, right_min_bounds));
}

void append_pair_direct(uvec2 pair_record)
{
    uint pair_index = atomicAdd(pair_count, 1u);
    if (pair_index >= uMaxPairCount) {
        atomicAdd(overflow_count, 1u);
        return;
    }

    pair_records[pair_index] = pair_record;
}

void append_pair(uint cloth_vertex_id, uint body_triangle_id)
{
    uvec2 pair_record = uvec2(cloth_vertex_id, body_triangle_id);
    uint group_pair_index = atomicAdd(group_pair_count, 1u);
    if (group_pair_index < group_pair_capacity) {
        group_pairs[group_pair_index] = pair_record;
        return;
    }

    append_pair_direct(pair_record);
}

void flush_group_pairs()
{
    barrier();

    uint stored_pair_count = min(group_pair_count, group_pair_capacity);
    if (gl_LocalInvocationIndex == 0u) {
        if (stored_pair_count == 0u) {
            group_base_index = 0u;
        } else {
            group_base_index = atomicAdd(pair_count, stored_pair_count);
            if (group_base_index >= uMaxPairCount) {
                atomicAdd(overflow_count, stored_pair_count);
            } else {
                uint available_pair_count = uMaxPairCount - group_base_index;
                if (stored_pair_count > available_pair_count) {
                    atomicAdd(overflow_count, stored_pair_count - available_pair_count);
                }
            }
        }
    }

    barrier();

    for (uint group_pair_index = gl_LocalInvocationIndex;
         group_pair_index < stored_pair_count;
         group_pair_index += gl_WorkGroupSize.x) {
        uint pair_index = group_base_index + group_pair_index;
        if (pair_index < uMaxPairCount) {
            pair_records[pair_index] = group_pairs[group_pair_index];
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_pair_count = 0u;
    }
    barrier();

    uint cloth_vertex_id = gl_GlobalInvocationID.x;
    if (cloth_vertex_id < uClothVertexCount) {
        vec3 previous_position = read_cloth_previous_position(cloth_vertex_id);
        vec3 current_position = read_cloth_current_position(cloth_vertex_id);
        Aabb query_bounds = build_swept_vertex_aabb(previous_position, current_position);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = bvh_root_node;

        while (stack_count > 0u) {
            --stack_count;
            BvhNode current_node = bvh_nodes[node_index_stack[stack_count]];
            if (is_ignored_body_part_node(current_node)) {
                continue;
            }

            if (!overlaps_aabb(query_bounds, current_node.min_bounds.xyz, current_node.max_bounds.xyz)) {
                continue;
            }

            if (is_leaf_node(current_node)) {
                for (uint triangle_offset = 0u; triangle_offset < current_node.element_count; ++triangle_offset) {
                    uint triangle_index = current_node.first_element_index + triangle_offset;
                    if (triangle_geometry[triangle_index].normal.w == 0.0) {
                        continue;
                    }

                    Aabb triangle_bounds = build_body_triangle_aabb(triangle_index);
                    if (overlaps_aabb(query_bounds, triangle_bounds.min_bounds, triangle_bounds.max_bounds)) {
                        append_pair(cloth_vertex_id, triangle_index);
                    }
                }
            } else {
                node_index_stack[stack_count++] = current_node.left_child_index;
                node_index_stack[stack_count++] = current_node.right_child_index;
            }
        }
    }

    flush_group_pairs();
}
