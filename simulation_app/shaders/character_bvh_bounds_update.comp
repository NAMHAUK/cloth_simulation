#version 430 core

layout(local_size_x = 128) in;

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 face_normal;
    vec4 unit_face_normal;
};

struct MeshBvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uvec4 metadata;
};

layout(std430, binding = 0) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 1) buffer MeshBvhNodeBuffer {
    MeshBvhNode bvh_nodes[];
};

uniform uint uFirstNode;
uniform uint uNodeCount;

void update_leaf_bounds(uint node_index, uvec4 metadata)
{
    uint first_triangle = metadata.x;
    uint triangle_count = metadata.y;

    vec3 min_bounds = vec3(3.402823e+38);
    vec3 max_bounds = vec3(-3.402823e+38);
    for (uint triangle_offset = 0u; triangle_offset < triangle_count; ++triangle_offset) {
        uint triangle_index = first_triangle + triangle_offset;
        vec3 a = triangle_geometry[triangle_index].a.xyz;
        vec3 b = triangle_geometry[triangle_index].b.xyz;
        vec3 c = triangle_geometry[triangle_index].c.xyz;
        min_bounds = min(min_bounds, min(a, min(b, c)));
        max_bounds = max(max_bounds, max(a, max(b, c)));
    }

    bvh_nodes[node_index].min_bounds = vec4(min_bounds, 0.0);
    bvh_nodes[node_index].max_bounds = vec4(max_bounds, 0.0);
}

void update_internal_bounds(uint node_index, uvec4 metadata)
{
    uint left_child_index = metadata.x;
    uint right_child_index = metadata.y;

    vec3 min_bounds = min(bvh_nodes[left_child_index].min_bounds.xyz, bvh_nodes[right_child_index].min_bounds.xyz);
    vec3 max_bounds = max(bvh_nodes[left_child_index].max_bounds.xyz, bvh_nodes[right_child_index].max_bounds.xyz);

    bvh_nodes[node_index].min_bounds = vec4(min_bounds, 0.0);
    bvh_nodes[node_index].max_bounds = vec4(max_bounds, 0.0);
}

void main()
{
    uint local_node_index = gl_GlobalInvocationID.x;
    if (local_node_index >= uNodeCount) {
        return;
    }

    uint node_index = uFirstNode + local_node_index;
    uvec4 metadata = bvh_nodes[node_index].metadata;
    if (metadata.w > 0u) {
        update_leaf_bounds(node_index, metadata);
    } else {
        update_internal_bounds(node_index, metadata);
    }
}
