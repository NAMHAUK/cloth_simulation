#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer TriangleNormals {
    vec4 triangle_normals[];
};

layout(std430, binding = 1) readonly buffer AdjacentTriangleOffsets {
    uint adjacent_triangle_offsets[];
};

layout(std430, binding = 2) readonly buffer AdjacentTriangleIndices {
    uint adjacent_triangle_indices[];
};

layout(std430, binding = 3) writeonly buffer VertexNormals {
    vec4 vertex_normals[];
};

uniform uint uVertexCount;
uniform uint uTriangleNormalStride;
uniform uint uTriangleNormalOffset;

vec3 safe_normalize(vec3 normal)
{
    float length_squared = dot(normal, normal);
    return length_squared > 1.0e-20 ? normal * inversesqrt(length_squared) : vec3(0.0, 1.0, 0.0);
}

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    uint begin = adjacent_triangle_offsets[vertex_index];
    uint end = adjacent_triangle_offsets[vertex_index + 1u];

    vec3 normal_sum = vec3(0.0);
    for (uint entry_index = begin; entry_index < end; ++entry_index) {
        uint triangle_index = adjacent_triangle_indices[entry_index];
        uint normal_index = triangle_index * uTriangleNormalStride + uTriangleNormalOffset;
        normal_sum += triangle_normals[normal_index].xyz;
    }

    vertex_normals[vertex_index] = vec4(safe_normalize(normal_sum), 0.0);
}
