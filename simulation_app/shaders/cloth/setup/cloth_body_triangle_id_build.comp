#version 430 core

layout(local_size_x = 128) in;

#include "../../mesh/bvh_common.glsl"

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) writeonly buffer ClothBodyTriangleIds {
    uint cloth_body_triangle_ids[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = 2) readonly buffer BodyTriangleGeometryBuffer {
    TriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer BodyTriangleBvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform uint uVertexCount;
uniform float uSearchRadiusSquared;

const uint invalid_triangle_id = 0xffffffffu;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"
#include "../../body/body_mesh_search.glsl"

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    vec3 cloth_position = read_cloth_current_position(vertex_index);
    NearestBodySurface nearest_surface;
    bool has_surface = find_nearest_body_surface(cloth_position, uSearchRadiusSquared, nearest_surface);
    cloth_body_triangle_ids[vertex_index] = has_surface ? nearest_surface.triangle_index
                                                        : invalid_triangle_id;
}
