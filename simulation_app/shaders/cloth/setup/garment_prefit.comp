#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

#include "../../bvh/bvh.glsl"

layout(std430, binding = CLOTH_CURRENT_POSITIONS) buffer CurrentPositions {
    vec4 cloth_current_positions[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = BODY_TRIANGLE_POSITIONS) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

layout(std430, binding = BODY_TRIANGLE_BVH_NODES) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform float uSearchRadiusSquared;

uniform uint uVertexOffset;
uniform uint uVertexCount;
uniform uint uIterationCount;
uniform float uPushoutMargin;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"
#include "../../bvh/body_surface_search.glsl"

void store_cloth_position(uint vertex_index, vec3 position)
{
    cloth_current_positions[vertex_index] = vec4(position, 0.0);
}

void main()
{
    uint local_vertex_index = gl_GlobalInvocationID.x;
    if (local_vertex_index >= uVertexCount) {
        return;
    }
    uint cloth_vertex_index = uVertexOffset + local_vertex_index;

    vec3 cloth_position = read_cloth_current_position(cloth_vertex_index);

    for (uint iteration = 0u; iteration < uIterationCount; ++iteration) {
        NearestBodySurface nearest_surface;
        if (!find_nearest_body_surface(cloth_position, uSearchRadiusSquared, nearest_surface)) {
            continue;
        }

        float signed_distance = dot(cloth_position - nearest_surface.point, nearest_surface.normal);
        if (signed_distance < uPushoutMargin) {
            cloth_position = nearest_surface.point + nearest_surface.normal * uPushoutMargin;
        }
    }

    store_cloth_position(cloth_vertex_index, cloth_position);
}
