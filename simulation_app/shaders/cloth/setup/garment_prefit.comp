#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform float uSearchRadius;

uniform uint uVertexOffset;
uniform uint uVertexCount;
uniform float uPushoutMargin;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

float length_squared(vec3 value)
{
    return dot(value, value);
}

#include "character_mesh_search.glsl"

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    current_positions[base] = position.x;
    current_positions[base + 1u] = position.y;
    current_positions[base + 2u] = position.z;
}

void main()
{
    uint local_vertex_index = gl_GlobalInvocationID.x;
    if (local_vertex_index >= uVertexCount) {
        return;
    }
    uint cloth_vertex_index = uVertexOffset + local_vertex_index;

    vec3 cloth_position = load_cloth_position(cloth_vertex_index);

    // init
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = uSearchRadius * uSearchRadius;
    bool has_surface_point = false;

    uint node_index_stack[max_bvh_stack_depth];
    float node_distance_stack[max_bvh_stack_depth];
    uint stack_count = 0u;

    BvhNode root_node = bvh_nodes[bvh_root_node];
    node_index_stack[stack_count] = bvh_root_node;
    node_distance_stack[stack_count] = squared_distance_to_bounds(cloth_position, root_node);
    ++stack_count;

    while (stack_count > 0u) {
        --stack_count;
        uint current_node_index = node_index_stack[stack_count];
        float distance_to_node_sq = node_distance_stack[stack_count];

        if (distance_to_node_sq <= best_distance_sq) {
            BvhNode current_node = bvh_nodes[current_node_index];
            if (is_leaf_node(current_node)) {
                for (uint triangle_offset = 0u; triangle_offset < current_node.element_count; ++triangle_offset) {
                    update_nearest_character_surface_point(current_node.first_element_index + triangle_offset,
                                                           cloth_position,
                                                           best_closest_point,
                                                           best_normal,
                                                           best_distance_sq,
                                                           has_surface_point);
                }
            } else {
                push_child_nodes(cloth_position,
                                 current_node,
                                 best_distance_sq,
                                 node_index_stack,
                                 node_distance_stack,
                                 stack_count);
            }
        }
    }

    if (!has_surface_point) {
        return;
    }

    float signed_distance = dot(cloth_position - best_closest_point, best_normal);
    if (signed_distance < uPushoutMargin) {
        store_cloth_position(cloth_vertex_index, best_closest_point + best_normal * uPushoutMargin);
    }
}
