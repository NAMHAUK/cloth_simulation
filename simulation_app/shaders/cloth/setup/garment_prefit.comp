#version 430 core

layout(local_size_x = 128) in;

#include "../../mesh/bvh_common.glsl"

layout(std430, binding = 0) buffer CurrentPositions {
    float cloth_current_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform float uSearchRadiusSquared;

uniform uint uVertexOffset;
uniform uint uVertexCount;
uniform float uPushoutMargin;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"
#include "../../character/character_mesh_search.glsl"

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    cloth_current_positions[base] = position.x;
    cloth_current_positions[base + 1u] = position.y;
    cloth_current_positions[base + 2u] = position.z;
}

void main()
{
    uint local_vertex_index = gl_GlobalInvocationID.x;
    if (local_vertex_index >= uVertexCount) {
        return;
    }
    uint cloth_vertex_index = uVertexOffset + local_vertex_index;

    vec3 cloth_position = read_cloth_current_position(cloth_vertex_index);

    NearestCharacterSurface nearest_surface;
    if (!find_nearest_character_surface(cloth_position, uSearchRadiusSquared, nearest_surface)) {
        return;
    }

    float signed_distance = dot(cloth_position - nearest_surface.point, nearest_surface.normal);
    if (signed_distance < uPushoutMargin) {
        store_cloth_position(cloth_vertex_index, nearest_surface.point + nearest_surface.normal * uPushoutMargin);
    }
}
