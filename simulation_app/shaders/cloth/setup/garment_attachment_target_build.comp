#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer AttachmentIndices {
    uvec2 attachment_indices[];
};

layout(std430, binding = 2) writeonly buffer AttachmentBarycentricOffsets {
    vec4 barycentric_offsets[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

layout(std430, binding = 3) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 4) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

const float max_float = 3.402823466e+38;

uniform uint uConstraintOffset;
uniform uint uConstraintCount;
uniform float uSurfaceOffset;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

float length_squared(vec3 value)
{
    return dot(value, value);
}

#include "character_mesh_search.glsl"

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

vec3 closest_barycentric_on_triangle(vec3 point, vec3 a, vec3 b, vec3 c)
{
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 ap = point - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return vec3(1.0, 0.0, 0.0);
    }

    vec3 bp = point - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return vec3(0.0, 1.0, 0.0);
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        return vec3(1.0 - v, v, 0.0);
    }

    vec3 cp = point - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return vec3(0.0, 0.0, 1.0);
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        return vec3(1.0 - w, 0.0, w);
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return vec3(0.0, 1.0 - w, w);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return vec3(1.0 - v - w, v, w);
}

vec3 barycentric_on_triangle(uint triangle_index, vec3 point)
{
    vec3 a = triangle_geometry[triangle_index].a.xyz;
    vec3 b = triangle_geometry[triangle_index].b.xyz;
    vec3 c = triangle_geometry[triangle_index].c.xyz;
    return closest_barycentric_on_triangle(point, a, b, c);
}

void main()
{
    uint local_index = gl_GlobalInvocationID.x;
    if (local_index >= uConstraintCount) {
        return;
    }

    uint constraint_index = uConstraintOffset + local_index;
    uvec2 attachment_index = attachment_indices[constraint_index];
    uint cloth_vertex_index = attachment_index.x;
    vec3 cloth_position = load_cloth_position(cloth_vertex_index);

    // init
    uint best_triangle_index = 0u;
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = max_float;
    bool has_candidate = false;

    uint node_index_stack[max_bvh_stack_depth];
    float node_distance_stack[max_bvh_stack_depth];
    uint stack_count = 0u;

    BvhNode root_node = bvh_nodes[bvh_root_node];
    node_index_stack[stack_count] = bvh_root_node;
    node_distance_stack[stack_count] = squared_distance_to_bounds(cloth_position, root_node);
    ++stack_count;

    while (stack_count > 0u) {
        --stack_count;
        uint current_node_index = node_index_stack[stack_count];
        float distance_to_node_sq = node_distance_stack[stack_count];

        if (distance_to_node_sq <= best_distance_sq) {
            BvhNode current_node = bvh_nodes[current_node_index];
            if (is_leaf_node(current_node)) {
                for (uint triangle_offset = 0u; triangle_offset < current_node.element_count; ++triangle_offset) {
                    uint triangle_index = current_node.first_element_index + triangle_offset;
                    if (update_nearest_contact(triangle_index,
                                               cloth_position,
                                               best_closest_point,
                                               best_normal,
                                               best_distance_sq,
                                               has_candidate)) {
                        best_triangle_index = triangle_index;
                    }
                }
            } else {
                push_child_nodes(cloth_position,
                                 current_node,
                                 best_distance_sq,
                                 node_index_stack,
                                 node_distance_stack,
                                 stack_count);
            }
        }
    }

    vec3 best_barycentric = has_candidate
        ? barycentric_on_triangle(best_triangle_index, best_closest_point)
        : vec3(1.0, 0.0, 0.0);

    attachment_indices[constraint_index] = uvec2(cloth_vertex_index, best_triangle_index);
    barycentric_offsets[constraint_index] = vec4(best_barycentric, has_candidate ? uSurfaceOffset : 0.0);
}
