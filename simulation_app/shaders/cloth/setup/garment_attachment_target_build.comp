#version 430 core

layout(local_size_x = 128) in;

#include "../../mesh/bvh_common.glsl"

layout(std430, binding = 0) readonly buffer CurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) buffer AttachmentIndices {
    uvec2 attachment_indices[];
};

layout(std430, binding = 2) writeonly buffer AttachmentBarycentricOffsets {
    vec4 barycentric_offsets[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = 3) readonly buffer BodyTriangleGeometryBuffer {
    TriangleGeometry triangle_geometry[];
};

layout(std430, binding = 4) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

const float max_float = 3.402823466e+38;

uniform uint uConstraintOffset;
uniform uint uConstraintCount;
uniform float uSurfaceOffset;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"
#include "../../body/body_mesh_search.glsl"

vec3 barycentric_on_triangle(uint triangle_index, vec3 point)
{
    vec3 a = triangle_geometry[triangle_index].a.xyz;
    vec3 b = triangle_geometry[triangle_index].b.xyz;
    vec3 c = triangle_geometry[triangle_index].c.xyz;
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 ap = point - a;
    float ab_ab = dot(ab, ab);
    float ab_ac = dot(ab, ac);
    float ac_ac = dot(ac, ac);
    float ap_ab = dot(ap, ab);
    float ap_ac = dot(ap, ac);
    float inverse_denominator = 1.0 / (ab_ab * ac_ac - ab_ac * ab_ac);
    float b_weight = (ac_ac * ap_ab - ab_ac * ap_ac) * inverse_denominator;
    float c_weight = (ab_ab * ap_ac - ab_ac * ap_ab) * inverse_denominator;
    return vec3(1.0 - b_weight - c_weight, b_weight, c_weight);
}

void main()
{
    uint local_index = gl_GlobalInvocationID.x;
    if (local_index >= uConstraintCount) {
        return;
    }

    uint constraint_index = uConstraintOffset + local_index;
    uint cloth_vertex_index = attachment_indices[constraint_index].x;
    vec3 cloth_position = read_cloth_current_position(cloth_vertex_index);

    NearestBodySurface nearest_surface;
    bool has_surface = find_nearest_body_surface(cloth_position, max_float, nearest_surface);

    attachment_indices[constraint_index] = uvec2(cloth_vertex_index, nearest_surface.triangle_index);
    barycentric_offsets[constraint_index] = has_surface
        ? vec4(barycentric_on_triangle(nearest_surface.triangle_index, nearest_surface.point), uSurfaceOffset)
        : vec4(1.0, 0.0, 0.0, 0.0);
}
