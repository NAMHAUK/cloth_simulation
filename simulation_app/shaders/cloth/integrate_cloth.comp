#version 430 core

#include "../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) buffer CurrentPositions {
    vec4 current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) buffer PreviousPositions {
    vec4 previous_positions[];
};

layout(std430, binding = CLOTH_COLLISION_PUSHOUTS) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = CLOTH_CLOTH_PUSHOUTS) buffer ClothClothPushouts {
    vec4 cloth_cloth_pushouts[];
};

layout(std430, binding = CLOTH_CONTACT_MOTION_DELTAS) buffer ContactMotionDeltas {
    vec4 contact_motion_deltas[];
};

uniform uint uVertexOffset;
uniform uint uVertexCount;
uniform float uDeltaTime;
uniform float uInverseDeltaTime;
uniform vec3 uExternalAcceleration;
uniform float uVelocityDamping;
uniform vec3 uFrameStartPosition;
uniform vec3 uFrameEndPosition;
uniform mat3 uFrameRotationDelta;
uniform vec3 uFrameStartVelocity;
uniform vec3 uFrameAcceleration;
uniform vec3 uFrameStartAngularVelocity;
uniform vec3 uFrameAngularAcceleration;
uniform float uFrameInertiaScale;

const float pushout_normal_epsilon = 1.0e-20;

void remove_inward_collision_velocity(inout vec3 velocity, vec3 unit_normal)
{
    float normal_velocity = dot(velocity, unit_normal);
    if (normal_velocity < 0.0) {
        velocity -= unit_normal * normal_velocity;
    }
}

void main()
{
    uint garment_vertex_index = gl_GlobalInvocationID.x;
    if (garment_vertex_index >= uVertexCount) {
        return;
    }
    uint vertex_index = uVertexOffset + garment_vertex_index;

    vec3 current = current_positions[vertex_index].xyz;
    vec3 previous = previous_positions[vertex_index].xyz;

    // collsion solver pushout 제외
    vec3 collision_pushout = collision_pushouts[vertex_index].xyz;
    vec3 cloth_cloth_pushout = cloth_cloth_pushouts[vertex_index].xyz;
    vec3 solved_velocity = (current - previous - collision_pushout - cloth_cloth_pushout) * uInverseDeltaTime;

    float cloth_cloth_pushout_length_sq = dot(cloth_cloth_pushout, cloth_cloth_pushout);
    if (cloth_cloth_pushout_length_sq > pushout_normal_epsilon) {
        remove_inward_collision_velocity(
            solved_velocity,
            cloth_cloth_pushout * inversesqrt(cloth_cloth_pushout_length_sq));
    }

    solved_velocity += contact_motion_deltas[vertex_index].xyz * uInverseDeltaTime;

    collision_pushouts[vertex_index] = vec4(0.0);
    cloth_cloth_pushouts[vertex_index] = vec4(0.0);
    contact_motion_deltas[vertex_index] = vec4(0.0);
     
    // update pos
    vec3 frame_offset = current - uFrameStartPosition;
    vec3 frame_velocity = uFrameStartVelocity + cross(uFrameStartAngularVelocity, frame_offset);
    vec3 relative_velocity = solved_velocity - frame_velocity;
    vec3 rotational_acceleration =
        cross(uFrameAngularAcceleration, frame_offset) +
        cross(uFrameStartAngularVelocity, cross(uFrameStartAngularVelocity, frame_offset)) +
        2.0 * cross(uFrameStartAngularVelocity, relative_velocity);
    vec3 relative_acceleration =
        uExternalAcceleration -
        (uFrameAcceleration + rotational_acceleration) * uFrameInertiaScale;
    relative_velocity = relative_velocity * uVelocityDamping + relative_acceleration * uDeltaTime;
    vec3 predicted_position =
        uFrameEndPosition + uFrameRotationDelta * (frame_offset + relative_velocity * uDeltaTime);

    previous_positions[vertex_index] = vec4(current, 0.0);
    current_positions[vertex_index] = vec4(predicted_position, 0.0);
}
