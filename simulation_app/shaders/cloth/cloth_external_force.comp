#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    vec4 current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    vec4 previous_positions[];
};

layout(std430, binding = 2) buffer Velocities {
    vec4 velocities[];
};

layout(std430, binding = 3) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = 4) buffer ClothClothPushouts {
    vec4 cloth_cloth_pushouts[];
};

uniform uint uVertexCount;
uniform float uDeltaTime;
uniform vec3 uExternalAcceleration;
uniform float uVelocityDamping;
uniform vec3 uRootTranslation;
uniform vec3 uPreviousRootVelocity;
uniform vec3 uRootAcceleration;
uniform float uRootInertiaScale;

const float pushout_normal_epsilon = 1.0e-20;

void remove_inward_collision_velocity(inout vec3 velocity, vec3 unit_normal)
{
    float normal_velocity = dot(velocity, unit_normal);
    if (normal_velocity < 0.0) {
        velocity -= unit_normal * normal_velocity;
    }
}

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    vec3 current = current_positions[vertex_index].xyz;
    vec3 previous = previous_positions[vertex_index].xyz;

    // collsion solver pushout 제외
    vec3 collision_pushout = collision_pushouts[vertex_index].xyz;
    vec3 cloth_cloth_pushout = cloth_cloth_pushouts[vertex_index].xyz;
    vec3 solved_velocity = (current - previous - collision_pushout - cloth_cloth_pushout) / uDeltaTime;

    // remove inward velocity along the pushout direction
    float pushout_length_sq = dot(collision_pushout, collision_pushout);
    if (pushout_length_sq > pushout_normal_epsilon) {
        remove_inward_collision_velocity(solved_velocity, collision_pushout * inversesqrt(pushout_length_sq));
    }

    float cloth_cloth_pushout_length_sq = dot(cloth_cloth_pushout, cloth_cloth_pushout);
    if (cloth_cloth_pushout_length_sq > pushout_normal_epsilon) {
        remove_inward_collision_velocity(
            solved_velocity,
            cloth_cloth_pushout * inversesqrt(cloth_cloth_pushout_length_sq));
    }

    collision_pushouts[vertex_index] = vec4(0.0);
    cloth_cloth_pushouts[vertex_index] = vec4(0.0);
     
    // update pos, vel
    vec3 relative_velocity = solved_velocity - uPreviousRootVelocity;
    relative_velocity = relative_velocity * uVelocityDamping +
                        (uExternalAcceleration - uRootAcceleration * uRootInertiaScale) * uDeltaTime;
    vec3 velocity = uRootTranslation / uDeltaTime + relative_velocity;
    vec3 predicted_position = current + uRootTranslation + relative_velocity * uDeltaTime;

    previous_positions[vertex_index] = vec4(current, 0.0);
    current_positions[vertex_index] = vec4(predicted_position, 0.0);
    velocities[vertex_index] = vec4(velocity, 0.0);
}
