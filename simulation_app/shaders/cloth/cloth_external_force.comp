#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

layout(std430, binding = 2) buffer Velocities {
    float velocities[];
};

layout(std430, binding = 3) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

uniform uint uVertexCount;
uniform float uDeltaTime;
uniform vec3 uExternalAcceleration;
uniform float uVelocityDamping;

const float pushout_normal_epsilon = 1.0e-20;

void remove_inward_collision_velocity(inout vec3 velocity, vec3 unit_normal)
{
    float normal_velocity = dot(velocity, unit_normal);
    if (normal_velocity < 0.0) {
        velocity -= unit_normal * normal_velocity;
    }
}

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    uint position_base = vertex_index * 3u;
    vec3 current = vec3(current_positions[position_base],
                        current_positions[position_base + 1u],
                        current_positions[position_base + 2u]);
    vec3 previous = vec3(previous_positions[position_base],
                        previous_positions[position_base + 1u],
                        previous_positions[position_base + 2u]);

    // collsion solver velocity ?œì™¸
    vec4 collision_pushout = collision_pushouts[vertex_index];
    vec3 solved_velocity = (current - previous - collision_pushout.xyz) / uDeltaTime;

    
    // remove inward velocity along the pushout direction
    float pushout_length_sq = dot(collision_pushout.xyz, collision_pushout.xyz);
    if (pushout_length_sq > pushout_normal_epsilon) {
        remove_inward_collision_velocity(solved_velocity, collision_pushout.xyz * inversesqrt(pushout_length_sq));
    }

    collision_pushouts[vertex_index] = vec4(0.0);
     
    // update pos, vel
    vec3 velocity = solved_velocity * uVelocityDamping + uExternalAcceleration * uDeltaTime;
    vec3 predicted_position = current + velocity * uDeltaTime;

    previous_positions[position_base] = current.x;
    previous_positions[position_base + 1u] = current.y;
    previous_positions[position_base + 2u] = current.z;

    current_positions[position_base] = predicted_position.x;
    current_positions[position_base + 1u] = predicted_position.y;
    current_positions[position_base + 2u] = predicted_position.z;

    velocities[position_base] = velocity.x;
    velocities[position_base + 1u] = velocity.y;
    velocities[position_base + 2u] = velocity.z;
}
