#version 430 core

layout(local_size_x = 128) in;

const float max_float = 3.402823e+38;

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

struct BvhBounds {
    vec4 min_bounds;
    vec4 max_bounds;
};

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

layout(std430, binding = 3) buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 4) buffer ClothTriangleBounds {
    BvhBounds triangle_bounds[];
};

uniform uint uVertexOffset;
uniform uint uCollisionTriangleOffset;
uniform uint uBvhNodeOffset;
uniform uint uLevelFirstNode;
uniform uint uLevelNodeCount;
uniform float uBoundsMargin;

vec3 load_current_position(uint vertex_index)
{
    uint position_base = vertex_index * 3u;
    return vec3(current_positions[position_base],
                current_positions[position_base + 1u],
                current_positions[position_base + 2u]);
}

vec3 load_previous_position(uint vertex_index)
{
    uint position_base = vertex_index * 3u;
    return vec3(previous_positions[position_base],
                previous_positions[position_base + 1u],
                previous_positions[position_base + 2u]);
}

void update_leaf_bounds(uint packed_node_index, BvhNode node)
{
    vec3 leaf_min_bounds = vec3(max_float);
    vec3 leaf_max_bounds = vec3(-max_float);

    for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
        uint local_triangle_index = node.first_element_index + triangle_offset;
        uint packed_triangle_index = uCollisionTriangleOffset + local_triangle_index;
        uint index_base = packed_triangle_index * 3u;

        uint vertex_a = uVertexOffset + collision_triangle_indices[index_base];
        uint vertex_b = uVertexOffset + collision_triangle_indices[index_base + 1u];
        uint vertex_c = uVertexOffset + collision_triangle_indices[index_base + 2u];

        vec3 current_a = load_current_position(vertex_a);
        vec3 current_b = load_current_position(vertex_b);
        vec3 current_c = load_current_position(vertex_c);
        vec3 previous_a = load_previous_position(vertex_a);
        vec3 previous_b = load_previous_position(vertex_b);
        vec3 previous_c = load_previous_position(vertex_c);

        vec3 triangle_min_bounds = min(min(current_a, min(current_b, current_c)),
                                       min(previous_a, min(previous_b, previous_c))) - uBoundsMargin;
        vec3 triangle_max_bounds = max(max(current_a, max(current_b, current_c)),
                                       max(previous_a, max(previous_b, previous_c))) + uBoundsMargin;

        triangle_bounds[packed_triangle_index].min_bounds = vec4(triangle_min_bounds, 0.0);
        triangle_bounds[packed_triangle_index].max_bounds = vec4(triangle_max_bounds, 0.0);
        leaf_min_bounds = min(leaf_min_bounds, triangle_min_bounds);
        leaf_max_bounds = max(leaf_max_bounds, triangle_max_bounds);
    }

    bvh_nodes[packed_node_index].min_bounds = vec4(leaf_min_bounds, 0.0);
    bvh_nodes[packed_node_index].max_bounds = vec4(leaf_max_bounds, node.max_bounds.w);
}

void update_internal_bounds(uint packed_node_index, BvhNode node)
{
    BvhNode left_child = bvh_nodes[uBvhNodeOffset + node.left_child_index];
    BvhNode right_child = bvh_nodes[uBvhNodeOffset + node.right_child_index];
    vec3 min_bounds = min(left_child.min_bounds.xyz, right_child.min_bounds.xyz);
    vec3 max_bounds = max(left_child.max_bounds.xyz, right_child.max_bounds.xyz);

    bvh_nodes[packed_node_index].min_bounds = vec4(min_bounds, 0.0);
    bvh_nodes[packed_node_index].max_bounds = vec4(max_bounds, node.max_bounds.w);
}

void main()
{
    uint level_node_offset = gl_GlobalInvocationID.x;
    if (level_node_offset >= uLevelNodeCount) {
        return;
    }

    uint local_node_index = uLevelFirstNode + level_node_offset;
    uint packed_node_index = uBvhNodeOffset + local_node_index;
    BvhNode node = bvh_nodes[packed_node_index];

    if (is_leaf_node(node)) {
        update_leaf_bounds(packed_node_index, node);
    } else {
        update_internal_bounds(packed_node_index, node);
    }
}
