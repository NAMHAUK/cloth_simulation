#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) buffer CurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = ATTACHMENT_INDICES) readonly buffer AttachmentIndices {
    uvec2 attachment_indices[];
};

layout(std430, binding = ATTACHMENT_BARYCENTRIC_OFFSETS) readonly buffer AttachmentBarycentricOffsets {
    vec4 barycentric_offsets[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = BODY_TRIANGLE_POSITIONS) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

uniform uint uConstraintOffset;
uniform uint uConstraintCount;
uniform float uStiffness;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"

void store_current_position(uint vertex_index, vec3 position)
{
    cloth_current_positions[vertex_index] = vec4(position, 0.0);
}

void main()
{
    uint local_index = gl_GlobalInvocationID.x;
    if (local_index >= uConstraintCount) {
        return;
    }

    uint constraint_index = uConstraintOffset + local_index;
    uvec2 attachment_index = attachment_indices[constraint_index];
    uint cloth_vertex = attachment_index.x;
    uint body_triangle = attachment_index.y;
    vec4 barycentric_offset = barycentric_offsets[constraint_index];

    TrianglePositions triangle = body_triangle_positions[body_triangle];
    vec4 triangle_normal = body_triangle_normals[body_triangle];
    vec3 target = triangle.a.xyz * barycentric_offset.x +
                  triangle.b.xyz * barycentric_offset.y +
                  triangle.c.xyz * barycentric_offset.z;
    if (triangle_normal.w > 0.0) {
        target += triangle_normal.xyz * barycentric_offset.w;
    }

    vec3 current = read_cloth_current_position(cloth_vertex);
    vec3 correction = (target - current) * uStiffness;

    store_current_position(cloth_vertex, current + correction);
}
