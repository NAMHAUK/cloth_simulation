#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) buffer CurrentPositions
{
    vec4 current_positions[];
};

layout(std430, binding = BENDING_EDGE_VERTEX_INDICES) readonly buffer BendingEdgeVertexIndices
{
    uvec2 vertex_indices[];
};

layout(std430, binding = BENDING_REST_LENGTHS) readonly buffer BendingRestLengths
{
    float rest_lengths[];
};

uniform uint uConstraintOffset;
uniform uint uConstraintCount;
uniform float uStiffness;

void main()
{
    uint local_index = gl_GlobalInvocationID.x;
    if (local_index >= uConstraintCount) {
        return;
    }

    uint constraint_index = uConstraintOffset + local_index;
    uvec2 edge = vertex_indices[constraint_index];

    vec3 position_a = current_positions[edge.x].xyz;
    vec3 position_b = current_positions[edge.y].xyz;

    vec3 delta = position_b - position_a;
    float length_sq = dot(delta, delta);
    if (length_sq <= 0.000000000001) {
        return;
    }

    float inv_length = inversesqrt(length_sq);
    float current_length = length_sq * inv_length;
    float rest_length = rest_lengths[constraint_index];
    float bend_error = current_length - rest_length;
    vec3 correction = 0.5 * uStiffness * bend_error * delta * inv_length;

    position_a += correction;
    position_b -= correction;

    current_positions[edge.x].xyz = position_a;
    current_positions[edge.y].xyz = position_b;
}
