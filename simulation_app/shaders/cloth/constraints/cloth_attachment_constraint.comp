#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer AttachmentIndices {
    uvec2 attachment_indices[];
};

layout(std430, binding = 2) readonly buffer AttachmentBarycentricOffsets {
    vec4 barycentric_offsets[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

layout(std430, binding = 3) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

uniform uint uConstraintOffset;
uniform uint uConstraintCount;
uniform float uStiffness;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"

void store_current_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    cloth_current_positions[base] = position.x;
    cloth_current_positions[base + 1u] = position.y;
    cloth_current_positions[base + 2u] = position.z;
}

void main()
{
    uint local_index = gl_GlobalInvocationID.x;
    if (local_index >= uConstraintCount) {
        return;
    }

    uint constraint_index = uConstraintOffset + local_index;
    uvec2 attachment_index = attachment_indices[constraint_index];
    uint cloth_vertex = attachment_index.x;
    uint character_triangle = attachment_index.y;
    vec4 barycentric_offset = barycentric_offsets[constraint_index];

    CharacterTriangleGeometry triangle = triangle_geometry[character_triangle];
    vec3 target = triangle.a.xyz * barycentric_offset.x +
                  triangle.b.xyz * barycentric_offset.y +
                  triangle.c.xyz * barycentric_offset.z;
    if (triangle.normal.w > 0.0) {
        target += triangle.normal.xyz * barycentric_offset.w;
    }

    vec3 current = read_cloth_current_position(cloth_vertex);
    vec3 correction = (target - current) * uStiffness;

    store_current_position(cloth_vertex, current + correction);
}
