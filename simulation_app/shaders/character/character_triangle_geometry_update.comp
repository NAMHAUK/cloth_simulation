#version 430 core

layout(local_size_x = 128) in;

#include "../mesh/primitive_geometry.glsl"

layout(std430, binding = 0) readonly buffer CharacterCurrentPositions {
    vec4 body_current_positions[];
};

layout(std430, binding = 1) readonly buffer CharacterIndices {
    uint triangle_indices[];
};

layout(std430, binding = 2) writeonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = 3) writeonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

uniform uint uTriangleCount;

#define POSITION_IO_BODY_CURRENT
#include "../mesh/position_io.glsl"

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uint index_base = triangle_index * 3u;
    vec3 a = read_body_current_position(triangle_indices[index_base]);
    vec3 b = read_body_current_position(triangle_indices[index_base + 1u]);
    vec3 c = read_body_current_position(triangle_indices[index_base + 2u]);

    body_triangle_positions[triangle_index] = TrianglePositions(a, b, c);
    body_triangle_normals[triangle_index] = triangle_normal(a, b, c);
}
