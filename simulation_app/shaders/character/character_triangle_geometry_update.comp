#version 430 core

layout(local_size_x = 128) in;

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

layout(std430, binding = 0) readonly buffer CharacterCurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) readonly buffer CharacterIndices {
    uint triangle_indices[];
};

layout(std430, binding = 2) writeonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

uniform uint uTriangleCount;

const float epsilon = 1.0e-20;

vec3 load_character_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uint index_base = triangle_index * 3u;
    vec3 a = load_character_position(triangle_indices[index_base]);
    vec3 b = load_character_position(triangle_indices[index_base + 1u]);
    vec3 c = load_character_position(triangle_indices[index_base + 2u]);

    vec3 face_normal = cross(b - a, c - a);
    float normal_length_sq = dot(face_normal, face_normal);
    float inv_normal_length = normal_length_sq > epsilon ? inversesqrt(normal_length_sq) : 0.0;
    float normal_length = inv_normal_length > 0.0 ? 1.0 / inv_normal_length : 0.0;

    triangle_geometry[triangle_index].a = vec4(a, 0.0);
    triangle_geometry[triangle_index].b = vec4(b, 0.0);
    triangle_geometry[triangle_index].c = vec4(c, 0.0);
    triangle_geometry[triangle_index].normal = vec4(inv_normal_length > 0.0 ? 
                                                    face_normal * inv_normal_length : vec3(0.0),
                                                    normal_length);
}
