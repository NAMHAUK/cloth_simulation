#version 430 core

#include "../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

#include "../mesh/primitive_geometry.glsl"

layout(std430, binding = CHARACTER_CURRENT_POSITIONS) readonly buffer CharacterCurrentPositions {
    vec4 body_current_positions[];
};

layout(std430, binding = CHARACTER_TRIANGLE_INDICES) readonly buffer CharacterIndices {
    uint triangle_indices[];
};

layout(std430, binding = BODY_TRIANGLE_POSITIONS) writeonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) writeonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

uniform uint uTriangleCount;

#define POSITION_IO_BODY_CURRENT
#define POSITION_IO_TRIANGLE_INDICES
#include "../mesh/position_io.glsl"

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uvec3 vertex_indices = read_triangle_indices(triangle_index);
    vec3 a = read_body_current_position(vertex_indices.x);
    vec3 b = read_body_current_position(vertex_indices.y);
    vec3 c = read_body_current_position(vertex_indices.z);

    body_triangle_positions[triangle_index] = TrianglePositions(a, b, c);
    body_triangle_normals[triangle_index] = triangle_normal(a, b, c);
}
