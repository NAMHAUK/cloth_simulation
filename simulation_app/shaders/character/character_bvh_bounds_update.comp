#version 430 core

layout(local_size_x = 128) in;

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

struct BvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uint left_child_index;
    uint right_child_index;
    uint first_element_index;
    uint element_count;
};

struct BodyElementAabb {
    vec4 min_bounds;
    vec4 max_bounds;
};

bool is_leaf_node(BvhNode node)
{
    return node.element_count > 0u;
}

layout(std430, binding = 0) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 1) readonly buffer CharacterTriangleIndices {
    uint triangle_indices[];
};

layout(std430, binding = 2) readonly buffer CharacterPreviousPositions {
    float previous_positions[];
};

layout(std430, binding = 3) buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 4) buffer BodyTriangleBounds {
    BodyElementAabb body_triangle_bounds[];
};

uniform uint uFirstNode;
uniform uint uNodeCount;
uniform float uCollisionThickness;

vec3 load_previous_position(uint vertex_index)
{
    uint base_index = vertex_index * 3u;
    return vec3(previous_positions[base_index],
                previous_positions[base_index + 1u],
                previous_positions[base_index + 2u]);
}

void update_leaf_bounds(uint node_index, BvhNode node)
{
    vec3 min_bounds = vec3(3.402823e+38);
    vec3 max_bounds = vec3(-3.402823e+38);
    for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
        uint triangle_index = node.first_element_index + triangle_offset;
        uint index_base = triangle_index * 3u;
        vec3 previous_a = load_previous_position(triangle_indices[index_base]);
        vec3 previous_b = load_previous_position(triangle_indices[index_base + 1u]);
        vec3 previous_c = load_previous_position(triangle_indices[index_base + 2u]);

        CharacterTriangleGeometry triangle = triangle_geometry[triangle_index];
        vec3 current_a = triangle.a.xyz;
        vec3 current_b = triangle.b.xyz;
        vec3 current_c = triangle.c.xyz;

        vec3 current_min_bounds = min(current_a, min(current_b, current_c));
        vec3 current_max_bounds = max(current_a, max(current_b, current_c));
        body_triangle_bounds[triangle_index].min_bounds = vec4(current_min_bounds - vec3(uCollisionThickness), 0.0);
        body_triangle_bounds[triangle_index].max_bounds = vec4(current_max_bounds + vec3(uCollisionThickness), triangle.normal.w);
        min_bounds = min(min_bounds, min(min(previous_a, min(previous_b, previous_c)), current_min_bounds));
        max_bounds = max(max_bounds, max(max(previous_a, max(previous_b, previous_c)), current_max_bounds));
    }

    bvh_nodes[node_index].min_bounds = vec4(min_bounds - vec3(uCollisionThickness), 0.0);
    bvh_nodes[node_index].max_bounds = vec4(max_bounds + vec3(uCollisionThickness), node.max_bounds.w);
}

void update_internal_bounds(uint node_index, BvhNode node)
{
    vec3 min_bounds = min(bvh_nodes[node.left_child_index].min_bounds.xyz, bvh_nodes[node.right_child_index].min_bounds.xyz);
    vec3 max_bounds = max(bvh_nodes[node.left_child_index].max_bounds.xyz, bvh_nodes[node.right_child_index].max_bounds.xyz);

    bvh_nodes[node_index].min_bounds = vec4(min_bounds, 0.0);
    bvh_nodes[node_index].max_bounds = vec4(max_bounds, node.max_bounds.w);
}

void main()
{
    uint local_node_index = gl_GlobalInvocationID.x;
    if (local_node_index >= uNodeCount) {
        return;
    }

    uint node_index = uFirstNode + local_node_index;
    BvhNode node = bvh_nodes[node_index];
    if (is_leaf_node(node)) {
        update_leaf_bounds(node_index, node);
    } else {
        update_internal_bounds(node_index, node);
    }
}
