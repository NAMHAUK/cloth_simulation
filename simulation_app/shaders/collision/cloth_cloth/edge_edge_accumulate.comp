#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

#include "../../mesh/primitive_geometry.glsl"

// Buffer bindings
layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_EDGE_INDICES) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATES) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATE_COUNT) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = CLOTH_COLLISION_PUSHOUTS) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = CLOTH_INWARD_MOTION_CORRECTIONS) readonly buffer InwardMotionCorrections
{
    vec4 inward_motion_corrections[];
};

layout(std430, binding = INWARD_MOTION_CORRECTION_SUMS) buffer InwardMotionCorrectionSums
{
    ivec4 inward_motion_correction_sums[];
};

// Uniforms
uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uCollisionStiffness;

// Shared dependencies
#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"

#include "../contact_geometry.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#define COLLISION_INWARD_MOTION_ACCUMULATE
#include "../correction.glsl"

#include "contact_correction.glsl"
#include "edge_contact.glsl"

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    if (candidate_index >= min(candidate_count, uMaxCandidateCount)) {
        return;
    }
    uvec2 edges = candidates[candidate_index];
    uvec4 vertices = uvec4(cloth_edge_indices[edges.x * 2u],
                          cloth_edge_indices[edges.x * 2u + 1u],
                          cloth_edge_indices[edges.y * 2u],
                          cloth_edge_indices[edges.y * 2u + 1u]);
    ClothEdgeEdgeContact contact;
    if (!compute_cloth_edge_edge_contact(vertices.xy, vertices.zw, uCollisionThickness, contact)) {
        return;
    }

    float inverse_denominator = 1.0 / dot(contact.weights, contact.weights);
    vec3 correction = contact.normal * contact.depth * uCollisionStiffness * inverse_denominator;
    vec3 relative_delta = vec3(0.0);
    for (uint corner = 0u; corner < 4u; ++corner) {
        relative_delta += contact.weights[corner] * compute_vertex_motion_delta(vertices[corner]);
    }
    vec3 inward_motion_correction = contact.normal * max(-dot(relative_delta, contact.normal), 0.0) * inverse_denominator;
    for (uint corner = 0u; corner < 4u; ++corner) {
        accumulate_contact_correction(vertices[corner],
                                      contact.weights[corner],
                                      correction,
                                      inward_motion_correction);
    }
}
