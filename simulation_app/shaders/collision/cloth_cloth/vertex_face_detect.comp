#version 430 core

#include "../../simulation_buffer_bindings.glsl"

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_TRIANGLE_VERTEX_INDICES) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};

layout(std430, binding = CLOTH_ADJACENT_TRIANGLE_OFFSETS) readonly buffer ClothAdjacentTriangleOffsets {
    uint cloth_adjacent_triangle_offsets[];
};

layout(std430, binding = CLOTH_ADJACENT_TRIANGLE_INDICES) readonly buffer ClothAdjacentTriangleIndices {
    uint cloth_adjacent_triangle_indices[];
};

layout(std430, binding = CLOTH_TRIANGLE_BOUNDS) readonly buffer ClothTriangleBounds {
    Aabb triangle_bounds[];
};

layout(std430, binding = CLOTH_BVH_NODES) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uUpperVertexOffset;
uniform uint uUpperVertexCount;
uniform uint uUpperBvhRoot;
uniform uint uLowerVertexOffset;
uniform uint uLowerVertexCount;
uniform uint uLowerBvhRoot;
uniform uint uMaxCandidateCount;

const uint max_bvh_stack_depth = 32u;
const uint group_candidate_capacity = 512u;

shared uint garment_roots_overlap;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../candidate_output.glsl"

bool roots_overlap()
{
    if (uUpperVertexCount == 0u || uLowerVertexCount == 0u) {
        return false;
    }

    BvhNode upper_root = bvh_nodes[uUpperBvhRoot];
    BvhNode lower_root = bvh_nodes[uLowerBvhRoot];
    return overlaps_aabb(upper_root.bounds, lower_root.bounds);
}

bool is_local_triangle(uint vertex_index, uint triangle_index)
{
    uint triangle_base = triangle_index * 3u;
    uvec3 face_vertices = uvec3(cloth_triangle_indices[triangle_base],
                                cloth_triangle_indices[triangle_base + 1u],
                                cloth_triangle_indices[triangle_base + 2u]);
    if (any(equal(face_vertices, uvec3(vertex_index)))) {
        return true;
    }

    // ponytail: One-ring exclusion; wider rest-topology filtering is needed when thickness exceeds mesh spacing.
    uint begin = cloth_adjacent_triangle_offsets[vertex_index];
    uint end = cloth_adjacent_triangle_offsets[vertex_index + 1u];
    for (uint entry_index = begin; entry_index < end; ++entry_index) {
        uint adjacent_base = cloth_adjacent_triangle_indices[entry_index] * 3u;
        for (uint corner = 0u; corner < 3u; ++corner) {
            if (any(equal(face_vertices, uvec3(cloth_triangle_indices[adjacent_base + corner])))) {
                return true;
            }
        }
    }
    return false;
}

void detect_vertex_face_candidates(uint cloth_vertex_index, uint target_bvh_root, bool is_self_contact)
{
    vec3 previous_position = read_cloth_previous_position(cloth_vertex_index);
    vec3 current_position = read_cloth_current_position(cloth_vertex_index);
    Aabb vertex_bounds = build_swept_aabb(previous_position, current_position);

    uint node_index_stack[max_bvh_stack_depth];
    uint stack_count = 0u;
    uint node_index = target_bvh_root;
    bool has_next_node = overlaps_aabb(vertex_bounds, bvh_nodes[node_index].bounds);

    while (has_next_node) {
        BvhNode node = bvh_nodes[node_index];
        if (is_leaf_node(node)) {
            for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
                uint triangle_index = node.first_element_index + triangle_offset;
                Aabb bounds = triangle_bounds[triangle_index];
                if (overlaps_aabb(vertex_bounds, bounds) &&
                    (!is_self_contact || !is_local_triangle(cloth_vertex_index, triangle_index))) {
                    append_candidate(uvec2(cloth_vertex_index, triangle_index));
                }
            }
        } else {
            bool left_overlap = overlaps_aabb(vertex_bounds,
                                              bvh_nodes[node.left_child_index].bounds);
            bool right_overlap = overlaps_aabb(vertex_bounds,
                                               bvh_nodes[node.right_child_index].bounds);
            if (left_overlap && right_overlap) {
                node_index_stack[stack_count++] = node.left_child_index;
            }
            if (left_overlap || right_overlap) {
                node_index = right_overlap ? node.right_child_index : node.left_child_index;
                continue;
            }
        }

        has_next_node = stack_count > 0u;
        if (has_next_node) {
            node_index = node_index_stack[--stack_count];
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
        garment_roots_overlap = roots_overlap() ? 1u : 0u;
    }
    barrier();

    uint dispatch_vertex_index = gl_GlobalInvocationID.x;
    uint garment_pair_vertex_count = uUpperVertexCount + uLowerVertexCount;
    
    if (dispatch_vertex_index < garment_pair_vertex_count) {
        bool is_upper_vertex = dispatch_vertex_index < uUpperVertexCount;
        uint vertex_index = is_upper_vertex ? uUpperVertexOffset + dispatch_vertex_index : uLowerVertexOffset + dispatch_vertex_index - uUpperVertexCount;
        if (garment_roots_overlap != 0u) {
            uint target_bvh_root = is_upper_vertex ? uLowerBvhRoot : uUpperBvhRoot;
            detect_vertex_face_candidates(vertex_index, target_bvh_root, false);
        }
        uint self_bvh_root = is_upper_vertex ? uUpperBvhRoot : uLowerBvhRoot;
        detect_vertex_face_candidates(vertex_index, self_bvh_root, true);
    }

    flush_group_candidates();
}
