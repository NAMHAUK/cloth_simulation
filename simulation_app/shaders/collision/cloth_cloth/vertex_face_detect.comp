#version 430 core

#include "../../simulation_buffer_bindings.glsl"
#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_VERTEX_FACE_EXCLUSIONS) readonly buffer ClothVertexFaceExclusions {
    uint vertex_face_exclusions[];
};

layout(std430, binding = CLOTH_TRIANGLE_BOUNDS) readonly buffer ClothTriangleBounds {
    Aabb triangle_bounds[];
};

layout(std430, binding = CLOTH_BVH_NODES) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

const uint layer_count = 2u;
const uint lower_layer = 0u;
const uint upper_layer = 1u;

uniform uint uVertexOffsets[layer_count];
uniform uint uVertexCounts[layer_count];
uniform uint uBvhRoots[layer_count];
uniform uint uTriangleOffsets[layer_count];
uniform uint uMasksPerVertex[layer_count];
uniform uint uExclusionOffsets[layer_count];
uniform uint uMaxCandidateCount;

shared bool garment_roots_overlap;

struct DetectionInput
{
    Aabb bounds;
    uint vertex_index;
    bool is_self_collision;
    uint exclusion_row_offset;
    uint triangle_offset;
};

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node);
void detect_leaf_candidates(DetectionInput detection_input, BvhNode node);

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../detection.glsl"

bool roots_overlap()
{
    if (uVertexCounts[lower_layer] == 0u || uVertexCounts[upper_layer] == 0u) {
        return false;
    }

    BvhNode upper_root = bvh_nodes[uBvhRoots[upper_layer]];
    BvhNode lower_root = bvh_nodes[uBvhRoots[lower_layer]];
    return overlaps_aabb(upper_root.bounds, lower_root.bounds);
}

bool is_excluded_vertex_face_pair(DetectionInput detection_input, uint triangle_index)
{
    if (!detection_input.is_self_collision) {
        return false;
    }
    uint local_triangle_index = triangle_index - detection_input.triangle_offset;
    uint mask_index = detection_input.exclusion_row_offset + local_triangle_index / 32u;
    return (vertex_face_exclusions[mask_index] & (1u << (local_triangle_index % 32u))) != 0u;
}

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node)
{
    bool can_visit_left = overlaps_aabb(detection_input.bounds, bvh_nodes[node.left_child_index].bounds);
    bool can_visit_right = overlaps_aabb(detection_input.bounds, bvh_nodes[node.right_child_index].bounds);
    return bvec2(can_visit_left, can_visit_right);
}

void detect_leaf_candidates(DetectionInput detection_input, BvhNode node)
{
    for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
        uint triangle_index = node.first_element_index + triangle_offset;
        if (overlaps_aabb(detection_input.bounds, triangle_bounds[triangle_index]) &&
            !is_excluded_vertex_face_pair(detection_input, triangle_index)) {
            append_candidate(uvec2(detection_input.vertex_index, triangle_index));
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
        garment_roots_overlap = roots_overlap();
    }
    barrier();

    uint dispatch_vertex_index = gl_GlobalInvocationID.x;
    uint vertex_count = uVertexCounts[lower_layer] + uVertexCounts[upper_layer];

    if (dispatch_vertex_index < vertex_count) {
        uint garment_index = dispatch_vertex_index < uVertexCounts[upper_layer] ? upper_layer : lower_layer;
        uint local_vertex = dispatch_vertex_index - (garment_index == upper_layer ? 0u : uVertexCounts[upper_layer]);
        uint vertex_index = uVertexOffsets[garment_index] + local_vertex;
        uint exclusion_offset = uExclusionOffsets[garment_index] + local_vertex * uMasksPerVertex[garment_index];
        Aabb bounds = build_swept_aabb(read_cloth_previous_position(vertex_index),
                                       read_cloth_current_position(vertex_index));
        DetectionInput detection_input = {bounds, vertex_index, false, exclusion_offset, uTriangleOffsets[garment_index]};

        // cloth-cloth collision detection
        if (garment_roots_overlap) {
            uint target_garment_index = garment_index == upper_layer ? lower_layer : upper_layer;
            detect_candidates(detection_input, uBvhRoots[target_garment_index]);
        }
        // self-collision detection
        detection_input.is_self_collision = true;
        detect_candidates(detection_input, uBvhRoots[garment_index]);
    }

    flush_group_candidates();
}
