#version 430 core

#include "../../simulation_buffer_bindings.glsl"

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_VERTEX_FACE_EXCLUSIONS) readonly buffer ClothVertexFaceExclusions {
    uint vertex_face_exclusions[];
};

layout(std430, binding = CLOTH_TRIANGLE_BOUNDS) readonly buffer ClothTriangleBounds {
    Aabb triangle_bounds[];
};

layout(std430, binding = CLOTH_BVH_NODES) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uVertexOffsets[2];
uniform uint uVertexCounts[2];
uniform uint uBvhRoots[2];
uniform uint uTriangleOffsets[2];
uniform uint uMasksPerVertex[2];
uniform uint uExclusionOffsets[2];
uniform uint uMaxCandidateCount;

const uint lower_layer = 0u;
const uint upper_layer = 1u;
const uint max_bvh_stack_depth = 32u;
const uint group_candidate_capacity = 512u;

shared uint garment_roots_overlap;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../candidate_output.glsl"

bool roots_overlap()
{
    if (uVertexCounts[lower_layer] == 0u || uVertexCounts[upper_layer] == 0u) {
        return false;
    }

    BvhNode upper_root = bvh_nodes[uBvhRoots[upper_layer]];
    BvhNode lower_root = bvh_nodes[uBvhRoots[lower_layer]];
    return overlaps_aabb(upper_root.bounds, lower_root.bounds);
}

bool is_local_triangle(uint local_triangle, uint exclusion_row_offset)
{
    uint mask_index = exclusion_row_offset + local_triangle / 32u;
    return (vertex_face_exclusions[mask_index] & (1u << (local_triangle % 32u))) != 0u;
}

void detect_vertex_face_candidates(uint cloth_vertex_index,
                                   uint target_bvh_root,
                                   bool is_self_contact,
                                   uint exclusion_row_offset,
                                   uint garment_triangle_offset)
{
    vec3 previous_position = read_cloth_previous_position(cloth_vertex_index);
    vec3 current_position = read_cloth_current_position(cloth_vertex_index);
    Aabb vertex_bounds = build_swept_aabb(previous_position, current_position);

    uint node_index_stack[max_bvh_stack_depth];
    uint stack_count = 0u;
    uint node_index = target_bvh_root;
    bool has_next_node = overlaps_aabb(vertex_bounds, bvh_nodes[node_index].bounds);

    while (has_next_node) {
        BvhNode node = bvh_nodes[node_index];
        if (is_leaf_node(node)) {
            for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
                uint triangle_index = node.first_element_index + triangle_offset;
                Aabb bounds = triangle_bounds[triangle_index];
                if (overlaps_aabb(vertex_bounds, bounds) &&
                    (!is_self_contact || !is_local_triangle(triangle_index - garment_triangle_offset, exclusion_row_offset))) {
                    append_candidate(uvec2(cloth_vertex_index, triangle_index));
                }
            }
        } else {
            bool left_overlap = overlaps_aabb(vertex_bounds,
                                              bvh_nodes[node.left_child_index].bounds);
            bool right_overlap = overlaps_aabb(vertex_bounds,
                                               bvh_nodes[node.right_child_index].bounds);
            if (left_overlap && right_overlap) {
                node_index_stack[stack_count++] = node.left_child_index;
            }
            if (left_overlap || right_overlap) {
                node_index = right_overlap ? node.right_child_index : node.left_child_index;
                continue;
            }
        }

        has_next_node = stack_count > 0u;
        if (has_next_node) {
            node_index = node_index_stack[--stack_count];
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
        garment_roots_overlap = roots_overlap() ? 1u : 0u;
    }
    barrier();

    uint dispatch_vertex_index = gl_GlobalInvocationID.x;
    uint garment_pair_vertex_count = uVertexCounts[lower_layer] + uVertexCounts[upper_layer];
    
    if (dispatch_vertex_index < garment_pair_vertex_count) {
        uint garment_index = dispatch_vertex_index < uVertexCounts[upper_layer] ? upper_layer : lower_layer;
        uint local_vertex = dispatch_vertex_index - (garment_index == upper_layer ? 0u : uVertexCounts[upper_layer]);
        uint vertex_index = uVertexOffsets[garment_index] + local_vertex;
        uint triangle_offset = uTriangleOffsets[garment_index];
        uint exclusion_row_offset = uExclusionOffsets[garment_index] + local_vertex * uMasksPerVertex[garment_index];
        
        if (garment_roots_overlap != 0u) {
            uint target_garment_index = garment_index == upper_layer ? lower_layer : upper_layer;
            detect_vertex_face_candidates(vertex_index,
                                          uBvhRoots[target_garment_index],
                                          false,
                                          exclusion_row_offset,
                                          triangle_offset);
        }
        detect_vertex_face_candidates(vertex_index,
                                      uBvhRoots[garment_index],
                                      true,
                                      exclusion_row_offset,
                                      triangle_offset);
    }

    flush_group_candidates();
}
