#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

#include "../../mesh/primitive_geometry.glsl"

// Buffer bindings
layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_TRIANGLE_VERTEX_INDICES) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATES) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = CLOTH_COLLISION_PUSHOUTS) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = CLOTH_CLOTH_PUSHOUTS) readonly buffer ClothClothPushouts {
    vec4 cloth_cloth_pushouts[];
};

layout(std430, binding = CLOTH_CONTACT_MOTION_DELTAS) readonly buffer ContactMotionDeltas {
    vec4 contact_motion_deltas[];
};

layout(std430, binding = CONTACT_MOTION_DELTA_SUMS) buffer ContactMotionDeltaSums {
    ivec4 contact_motion_delta_sums[];
};

// Uniforms
uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uCollisionStiffness;

// Shared dependencies
#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"

#include "../contact_geometry.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#define COLLISION_CONTACT_MOTION_ACCUMULATE
#include "../correction.glsl"

// Shader constants
const float distance_delta_epsilon = 1.0e-8;

struct VertexFaceContact {
    vec3 correction_normal;
    vec3 barycentric;
    float depth;
};

uvec3 load_face_vertices(uint triangle_index)
{
    uint triangle_base = triangle_index * 3u;
    return uvec3(cloth_triangle_indices[triangle_base],
                 cloth_triangle_indices[triangle_base + 1u],
                 cloth_triangle_indices[triangle_base + 2u]);
}

bool compute_boundary_contact(vec3 point,
                              TrianglePositions face,
                              vec3 face_normal,
                              out VertexFaceContact contact)
{
    vec3 closest_point = closest_point_on_triangle(point, face.a, face.b, face.c);
    vec3 separation = point - closest_point;
    float distance = length(separation);
    if (distance >= uCollisionThickness ||
        !compute_barycentric_if_inside(closest_point, face, contact.barycentric)) {
        return false;
    }

    contact.barycentric = max(contact.barycentric, vec3(0.0));
    contact.barycentric /= dot(contact.barycentric, vec3(1.0));
    contact.correction_normal = distance > 0.0 ? separation / distance : face_normal;
    contact.depth = uCollisionThickness - distance;
    return true;
}

bool compute_candidate_contact(uint vertex_index,
                               uvec3 face_vertex_indices,
                               out VertexFaceContact contact)
{
    vec3 previous_vertex_position = read_cloth_previous_position(vertex_index);
    vec3 current_vertex_position = read_cloth_current_position(vertex_index);
    TrianglePositions previous_face = read_cloth_previous_triangle(face_vertex_indices);
    TrianglePositions current_face = read_cloth_current_triangle(face_vertex_indices);

    vec3 previous_normal;
    vec3 current_normal;
    if (!compute_triangle_normal(previous_face, previous_normal) ||
        !compute_triangle_normal(current_face, current_normal)) {
        return false;
    }

    // Use the starting side only for this sweep and the zero-distance fallback.
    float signed_distance = dot(previous_vertex_position - previous_face.a, previous_normal);
    if (abs(signed_distance) <= distance_delta_epsilon) {
        signed_distance = dot(current_vertex_position - current_face.a, current_normal);
    }
    float normal_sign = signed_distance < 0.0 ? -1.0 : 1.0;
    previous_normal *= normal_sign;
    current_normal *= normal_sign;
    float previous_distance = dot(previous_vertex_position - previous_face.a, previous_normal);
    float current_distance = dot(current_vertex_position - current_face.a, current_normal);

    bool has_swept_contact = false;
    float distance_delta = previous_distance - current_distance;
    // Inside the thickness shell, sweep against the face itself.
    float contact_distance = previous_distance > uCollisionThickness ? uCollisionThickness : 0.0;
    if (previous_distance >= contact_distance &&
        current_distance <= contact_distance &&
        distance_delta > distance_delta_epsilon) {
        float hit_time = clamp((previous_distance - contact_distance) / distance_delta, 0.0, 1.0);
        vec3 hit_vertex_position = mix(previous_vertex_position, current_vertex_position, hit_time);
        TrianglePositions hit_face = interpolate_triangle_positions(previous_face, current_face, hit_time);
        vec3 hit_normal;
        if (compute_triangle_normal(hit_face, hit_normal)) {
            hit_normal *= normal_sign;
            float hit_distance = dot(hit_vertex_position - hit_face.a, hit_normal);
            vec3 hit_surface_point = hit_vertex_position - hit_normal * hit_distance;
            has_swept_contact = compute_barycentric_if_inside(hit_surface_point, hit_face, contact.barycentric);
        }
    }

    if (!has_swept_contact) {
        return compute_boundary_contact(current_vertex_position,
                                        current_face,
                                        current_normal,
                                        contact);
    }

    vec3 current_surface_point = interpolate_triangle_position(current_face, contact.barycentric);
    contact.depth = uCollisionThickness - dot(current_vertex_position - current_surface_point, current_normal);
    if (contact.depth <= 0.0) {
        return false;
    }

    contact.correction_normal = current_normal;
    return true;
}

vec3 compute_vertex_motion_delta(uint vertex_index)
{
    vec3 position_delta = read_cloth_current_position(vertex_index) - read_cloth_previous_position(vertex_index);
    vec3 collision_delta = collision_pushouts[vertex_index].xyz + cloth_cloth_pushouts[vertex_index].xyz;
    return position_delta - collision_delta + contact_motion_deltas[vertex_index].xyz;
}

void accumulate_contact_correction(uint vertex_index,
                                   float vertex_weight,
                                   vec3 correction,
                                   vec3 contact_motion_delta)
{
    if (vertex_weight == 0.0) {
        return;
    }

    accumulate_vertex_normal_correction(vertex_index, vertex_weight * correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
    accumulate_vertex_contact_motion_delta(vertex_index, vertex_weight * contact_motion_delta);
}

void accumulate_candidate_correction(uint vertex_index, uint triangle_index)
{
    uvec3 face_vertices = load_face_vertices(triangle_index);
    VertexFaceContact contact;
    if (!compute_candidate_contact(vertex_index, face_vertices, contact)) {
        return;
    }

    float inverse_denominator = 1.0 / (1.0 + dot(contact.barycentric, contact.barycentric));
    vec3 correction = contact.correction_normal * contact.depth * uCollisionStiffness * inverse_denominator;
    vec3 face_delta = compute_vertex_motion_delta(face_vertices.x) * contact.barycentric.x
                    + compute_vertex_motion_delta(face_vertices.y) * contact.barycentric.y
                    + compute_vertex_motion_delta(face_vertices.z) * contact.barycentric.z;
    vec3 relative_delta = compute_vertex_motion_delta(vertex_index) - face_delta;
    float inward_delta = dot(relative_delta, contact.correction_normal);
    vec3 contact_motion_delta = contact.correction_normal * max(-inward_delta, 0.0) * inverse_denominator;

    accumulate_contact_correction(vertex_index, 1.0, correction, contact_motion_delta);
    accumulate_contact_correction(face_vertices.x, -contact.barycentric.x, correction, contact_motion_delta);
    accumulate_contact_correction(face_vertices.y, -contact.barycentric.y, correction, contact_motion_delta);
    accumulate_contact_correction(face_vertices.z, -contact.barycentric.z, correction, contact_motion_delta);
}

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    if (candidate_index >= active_candidate_count) {
        return;
    }

    uvec2 candidate_indices = candidates[candidate_index];
    accumulate_candidate_correction(candidate_indices.x, candidate_indices.y);
}
