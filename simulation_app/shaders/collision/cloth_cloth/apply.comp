#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_CLOTH_PUSHOUTS) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) readonly buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = INWARD_MOTION_CORRECTION_SUMS) readonly buffer InwardMotionCorrectionSums
{
    ivec4 inward_motion_correction_sums[];
};

layout(std430, binding = CLOTH_INWARD_MOTION_CORRECTIONS) buffer InwardMotionCorrections
{
    vec4 inward_motion_corrections[];
};

uniform uint uVertexCount;
uniform float uMaxCorrectionLength;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_WRITE
#include "../../mesh/position_io.glsl"

#define COLLISION_CORRECTION_APPLY
#include "../correction.glsl"

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    ivec4 accumulated = normal_correction_sums[vertex_index];
    if (accumulated.w > 0) {
        vec3 correction_sum = vec3(accumulated.xyz) / correction_fixed_point_scale;
        vec3 averaged_correction = correction_sum / float(accumulated.w);
        vec3 final_correction = clamp_correction(averaged_correction);
        vec3 corrected_position = read_cloth_current_position(vertex_index) + final_correction;
        write_cloth_current_position(vertex_index, corrected_position);
        collision_pushouts[vertex_index].xyz += final_correction;
    }

    ivec4 inward_motion_accumulated = inward_motion_correction_sums[vertex_index];
    if (inward_motion_accumulated.w > 0) {
        float inverse_contact_count = 1.0 / (correction_fixed_point_scale * float(inward_motion_accumulated.w));
        inward_motion_corrections[vertex_index].xyz += vec3(inward_motion_accumulated.xyz) * inverse_contact_count;
    }
}
