#version 430 core

#include "../../simulation_buffer_bindings.glsl"
#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_EDGE_EXCLUSIONS) readonly buffer ClothEdgeExclusions {
    uint edge_exclusions[];
};
layout(std430, binding = CLOTH_EDGE_BOUNDS) readonly buffer ClothEdgeBounds {
    Aabb edge_bounds[];
};
layout(std430, binding = CLOTH_EDGE_BVH_NODES) readonly buffer ClothEdgeBvhNodes {
    BvhNode bvh_nodes[];
};
layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};
layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uEdgeOffset;
uniform uint uEdgeCount;
uniform uint uEdgeExclusionOffset;
uniform uint uTargetBvhRoot;
uniform bool uIsSelfCollision;
uniform uint uMaxCandidateCount;
uniform float uDetectionDistance;

struct DetectionInput
{
    Aabb bounds;
    uint edge_index;
};

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node);
void detect_leaf_candidates(DetectionInput detection_input, BvhNode node);

#include "../detection.glsl"

bool is_excluded_edge_pair(uint source_edge_index, uint target_edge_index)
{
    if (!uIsSelfCollision) {
        return false;
    }
    if (source_edge_index >= target_edge_index) {
        return true;
    }

    uint local_source_edge_index = source_edge_index - uEdgeOffset;
    uint local_target_edge_index = target_edge_index - uEdgeOffset;
    uint masks_per_edge = (uEdgeCount + 31u) / 32u;
    uint mask_index = uEdgeExclusionOffset + local_source_edge_index * masks_per_edge + local_target_edge_index / 32u;
    
    return (edge_exclusions[mask_index] & (1u << (local_target_edge_index % 32u))) != 0u;
}

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node)
{
    bool check_left_node_range = detection_input.edge_index < bvh_nodes[node.right_child_index].first_element_index;
    bool can_visit_left = (!uIsSelfCollision || check_left_node_range) &&
                          overlaps_aabb(detection_input.bounds, bvh_nodes[node.left_child_index].bounds);
    bool can_visit_right = overlaps_aabb(detection_input.bounds, bvh_nodes[node.right_child_index].bounds);
    return bvec2(can_visit_left, can_visit_right);
}

void detect_leaf_candidates(DetectionInput detection_input, BvhNode node)
{
    for (uint offset = 0u; offset < node.element_count; ++offset) {
        uint target_edge_index = node.first_element_index + offset;
        if (is_excluded_edge_pair(detection_input.edge_index, target_edge_index)) {
            continue;
        }
        
        Aabb target_bounds = expand_aabb(edge_bounds[target_edge_index], vec3(uDetectionDistance));
        if (overlaps_aabb(detection_input.bounds, target_bounds)) {
            append_candidate(uvec2(detection_input.edge_index, target_edge_index));
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();
    uint edge_offset = gl_GlobalInvocationID.x;
    if (edge_offset < uEdgeCount) {
        uint edge_index = uEdgeOffset + edge_offset;
        DetectionInput detection_input = DetectionInput(edge_bounds[edge_index], edge_index);
        detect_candidates(detection_input, uTargetBvhRoot);
    }
    flush_group_candidates();
}
