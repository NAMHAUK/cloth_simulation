#version 430 core

#include "../../simulation_buffer_bindings.glsl"
#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_EDGE_INDICES) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};
layout(std430, binding = CLOTH_EDGE_BOUNDS) readonly buffer ClothEdgeBounds {
    Aabb edge_bounds[];
};
layout(std430, binding = CLOTH_EDGE_BVH_NODES) readonly buffer ClothEdgeBvhNodes {
    BvhNode bvh_nodes[];
};
layout(std430, binding = CLOTH_TRIANGLE_VERTEX_INDICES) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};
layout(std430, binding = CLOTH_ADJACENT_TRIANGLE_OFFSETS) readonly buffer ClothAdjacentTriangleOffsets {
    uint cloth_adjacent_triangle_offsets[];
};
layout(std430, binding = CLOTH_ADJACENT_TRIANGLE_INDICES) readonly buffer ClothAdjacentTriangleIndices {
    uint cloth_adjacent_triangle_indices[];
};
layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};
layout(std430, binding = CLOTH_CLOTH_EDGE_EDGE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uEdgeOffset;
uniform uint uEdgeCount;
uniform uint uTargetBvhRoot;
uniform bool uIsSelfCollision;
uniform uint uMaxCandidateCount;
uniform float uDetectionDistance;

const uint max_bvh_stack_depth = 32u;
const uint group_candidate_capacity = 512u;

#include "../candidate_output.glsl"

bool are_local_edges(uint first_edge, uint second_edge)
{
    uvec2 first = uvec2(cloth_edge_indices[first_edge * 2u], cloth_edge_indices[first_edge * 2u + 1u]);
    uvec2 second = uvec2(cloth_edge_indices[second_edge * 2u], cloth_edge_indices[second_edge * 2u + 1u]);
    if (any(equal(first, uvec2(second.x))) || any(equal(first, uvec2(second.y)))) {
        return true;
    }
    // Match the VF one-ring exclusion using the existing rest-topology adjacency.
    for (uint endpoint = 0u; endpoint < 2u; ++endpoint) {
        uint vertex = first[endpoint];
        for (uint entry = cloth_adjacent_triangle_offsets[vertex];
             entry < cloth_adjacent_triangle_offsets[vertex + 1u]; ++entry) {
            uint base = cloth_adjacent_triangle_indices[entry] * 3u;
            for (uint corner = 0u; corner < 3u; ++corner) {
                if (any(equal(second, uvec2(cloth_triangle_indices[base + corner])))) {
                    return true;
                }
            }
        }
    }
    return false;
}

void detect_edge_candidates(uint edge_index)
{
    Aabb query_bounds = edge_bounds[edge_index];
    uint stack[max_bvh_stack_depth];
    uint stack_count = 0u;
    uint node_index = uTargetBvhRoot;
    bool has_next_node = overlaps_aabb(query_bounds, bvh_nodes[node_index].bounds);
    while (has_next_node) {
        BvhNode node = bvh_nodes[node_index];
        if (is_leaf_node(node)) {
            for (uint offset = 0u; offset < node.element_count; ++offset) {
                uint target_edge = node.first_element_index + offset;
                if (uIsSelfCollision && edge_index >= target_edge) {
                    continue;
                }
                Aabb target_bounds = expand_aabb(edge_bounds[target_edge], vec3(uDetectionDistance));
                if (overlaps_aabb(query_bounds, target_bounds) &&
                    (!uIsSelfCollision || !are_local_edges(edge_index, target_edge))) {
                    append_candidate(uvec2(edge_index, target_edge));
                }
            }
        } else {
            bool left_overlap = (!uIsSelfCollision || edge_index < bvh_nodes[node.right_child_index].first_element_index) &&
                                overlaps_aabb(query_bounds, bvh_nodes[node.left_child_index].bounds);
            bool right_overlap = overlaps_aabb(query_bounds, bvh_nodes[node.right_child_index].bounds);
            if (left_overlap && right_overlap) {
                stack[stack_count++] = node.left_child_index;
            }
            if (left_overlap || right_overlap) {
                node_index = right_overlap ? node.right_child_index : node.left_child_index;
                continue;
            }
        }
        has_next_node = stack_count > 0u;
        if (has_next_node) {
            node_index = stack[--stack_count];
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();
    uint edge_offset = gl_GlobalInvocationID.x;
    if (edge_offset < uEdgeCount) {
        detect_edge_candidates(uEdgeOffset + edge_offset);
    }
    flush_group_candidates();
}
