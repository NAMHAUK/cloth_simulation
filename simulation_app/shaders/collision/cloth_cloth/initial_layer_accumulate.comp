#version 430 core

#include "../../bvh/bvh.glsl"
#include "../../mesh/primitive_geometry.glsl"
#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = CLOTH_TRIANGLE_VERTEX_INDICES) readonly buffer ClothTriangleIndices {
    uint triangle_indices[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATES) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = BODY_TRIANGLE_POSITIONS) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

layout(std430, binding = BODY_TRIANGLE_BVH_NODES) readonly buffer BodyTriangleBvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uCollisionStiffness;
uniform float uSearchRadiusSquared;
uniform uint uUpperVertexOffset;
uniform uint uUpperVertexCount;

#define CLOTH_INITIAL_LAYER_CONTACT
#define POSITION_IO_TRIANGLE_INDICES

#include "contact_correction.glsl"

uint get_garment_layer(uint vertex_index)
{
    const uint lower_layer = 0u;
    const uint upper_layer = 1u;

    if (vertex_index - uUpperVertexOffset < uUpperVertexCount) {
        return upper_layer;
    } else {
        return lower_layer;
    }
}

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    if (candidate_index >= min(candidate_count, uMaxCandidateCount)) {
        return;
    }

    uvec2 candidate_indices = candidates[candidate_index];
    uint vertex_index = candidate_indices.x;
    uvec3 face_vertex_indices = read_triangle_indices(candidate_indices.y);

    uint vertex_layer = get_garment_layer(vertex_index);
    uint face_layer = get_garment_layer(face_vertex_indices.x);

    if (vertex_layer == face_layer) {
        vec3 normal;
        vec3 barycentric;
        float inverse_denominator;
        accumulate_vertex_face_penetration_correction(vertex_index,
                                                      face_vertex_indices,
                                                      normal,
                                                      barycentric,
                                                      inverse_denominator);
    } else {
        bool is_outer_vertex = vertex_layer > face_layer;
        accumulate_initial_layer_collision_correction(vertex_index, face_vertex_indices, is_outer_vertex);
    }
}
