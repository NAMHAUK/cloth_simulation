#version 430 core

layout(local_size_x = 128) in;

#include "../../bvh/bvh.glsl"

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};

layout(std430, binding = 2) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = 3) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = 4) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = 5) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = 6) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

layout(std430, binding = 7) readonly buffer BodyTriangleBvhNodeBuffer {
    BvhNode bvh_nodes[];
};

uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uCollisionStiffness;
uniform float uSearchRadiusSquared;
uniform uint uUpperVertexOffset;

#define POSITION_IO_CLOTH_CURRENT
#include "../../mesh/position_io.glsl"
#include "../../bvh/body_surface_search.glsl"
#include "../contact_geometry.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#include "../correction.glsl"

struct VertexFaceContact {
    vec3 correction_normal;
    vec3 barycentric;
    float depth;
};

uvec3 load_face_vertices(uint triangle_index)
{
    uint triangle_base = triangle_index * 3u;
    return uvec3(cloth_triangle_indices[triangle_base],
                 cloth_triangle_indices[triangle_base + 1u],
                 cloth_triangle_indices[triangle_base + 2u]);
}

bool find_body_outward_normal(vec3 surface_point, out vec3 outward_normal)
{
    NearestBodySurface nearest_surface;
    if (!find_nearest_body_surface(surface_point,
                                   uSearchRadiusSquared,
                                   nearest_surface)) {
        return false;
    }

    outward_normal = nearest_surface.normal;
    return true;
}

bool compute_candidate_contact(uint vertex_index,
                               bool is_upper_vertex,
                               uvec3 target_vertices,
                               out VertexFaceContact contact)
{
    vec3 query = read_cloth_current_position(vertex_index);
    TrianglePositions target = read_cloth_current_triangle(target_vertices);

    vec3 face_normal;
    if (!compute_triangle_normal(target, face_normal)) {
        return false;
    }

    float unoriented_distance = dot(query - target.a, face_normal);
    vec3 surface_point = query - face_normal * unoriented_distance;
    if (!compute_barycentric_if_inside(surface_point, target, contact.barycentric)) {
        return false;
    }

    vec3 body_outward_normal;
    if (!find_body_outward_normal(surface_point, body_outward_normal)) {
        return false;
    }
    if (dot(face_normal, body_outward_normal) < 0.0) {
        face_normal = -face_normal;
    }

    float query_from_face_distance = dot(query - target.a, face_normal);
    float upper_from_lower_distance = is_upper_vertex
        ? query_from_face_distance
        : -query_from_face_distance;
    contact.depth = uCollisionThickness - upper_from_lower_distance;
    if (contact.depth <= 0.0) {
        return false;
    }

    contact.correction_normal = body_outward_normal;
    return true;
}

void accumulate_upper_vertex(uint vertex_index, VertexFaceContact contact)
{
    vec3 correction = contact.correction_normal * contact.depth * uCollisionStiffness;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void accumulate_upper_face_vertex(uint vertex_index,
                                   float vertex_weight,
                                   float inverse_denominator,
                                   VertexFaceContact contact)
{
    if (vertex_weight <= 0.0) {
        return;
    }

    float weight_scale = vertex_weight * inverse_denominator;
    vec3 correction = contact.correction_normal * contact.depth * uCollisionStiffness * weight_scale;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    if (candidate_index >= active_candidate_count) {
        return;
    }

    uvec2 candidate_indices = candidates[candidate_index];
    uint vertex_index = candidate_indices.x;
    uint triangle_index = candidate_indices.y;
    bool is_upper_vertex = vertex_index >= uUpperVertexOffset;
    uvec3 target_vertices = load_face_vertices(triangle_index);
    VertexFaceContact contact;
    if (!compute_candidate_contact(vertex_index, is_upper_vertex, target_vertices, contact)) {
        return;
    }

    if (is_upper_vertex) {
        accumulate_upper_vertex(vertex_index, contact);
        return;
    }

    float inverse_denominator = 1.0 / dot(contact.barycentric, contact.barycentric);
    accumulate_upper_face_vertex(target_vertices.x,
                                  contact.barycentric.x,
                                  inverse_denominator,
                                  contact);
    accumulate_upper_face_vertex(target_vertices.y,
                                  contact.barycentric.y,
                                  inverse_denominator,
                                  contact);
    accumulate_upper_face_vertex(target_vertices.z,
                                  contact.barycentric.z,
                                  inverse_denominator,
                                  contact);
}
