#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer PairRecords {
    uvec4 pair_records[];
};

layout(std430, binding = 4) readonly buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 5) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 normal;
};

layout(std430, binding = 6) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 7) readonly buffer ClothBodyTriangleIds {
    uint cloth_body_triangle_ids[];
};

uniform uint uMaxPairCount;
uniform float uCollisionGap;
uniform float uBarrierStiffness;
uniform float uPenetrationTolerance;
uniform uint uCharacterTriangleCount;

const uint higher_vertex_lower_face_role = 0u;
const uint lower_vertex_higher_face_role = 1u;
const float distance_delta_epsilon = 1.0e-8;
const float normal_length_epsilon = 1.0e-12;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../mesh/position_io.glsl"
#include "common/collision_geometry_common.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#include "common/collision_correction_common.glsl"

struct VertexFaceContact {
    vec3 correction_normal;
    vec3 barycentric;
    float depth;
};

uvec3 load_target_vertices(uvec4 pair_record)
{
    uint triangle_base = pair_record.y * 3u;
    return uvec3(pair_record.z + collision_triangle_indices[triangle_base],
                 pair_record.z + collision_triangle_indices[triangle_base + 1u],
                 pair_record.z + collision_triangle_indices[triangle_base + 2u]);
}

bool read_cached_body_normal(uint cloth_vertex_index, out vec3 body_normal)
{
    uint body_triangle_id = cloth_body_triangle_ids[cloth_vertex_index];
    if (body_triangle_id >= uCharacterTriangleCount) {
        return false;
    }

    vec4 stored_normal = triangle_geometry[body_triangle_id].normal;
    if (stored_normal.w == 0.0) {
        return false;
    }

    body_normal = stored_normal.xyz;
    return true;
}

bool read_lower_body_normal(uvec4 pair_record,
                            uvec3 target_vertices,
                            vec3 barycentric,
                            out vec3 body_normal)
{
    if (pair_record.w == lower_vertex_higher_face_role) {
        return read_cached_body_normal(pair_record.x, body_normal);
    }

    vec3 blended_normal = vec3(0.0);
    vec3 vertex_normal;
    if (barycentric.x > 0.0 && read_cached_body_normal(target_vertices.x, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.x;
    }
    if (barycentric.y > 0.0 && read_cached_body_normal(target_vertices.y, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.y;
    }
    if (barycentric.z > 0.0 && read_cached_body_normal(target_vertices.z, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.z;
    }

    float normal_length_sq = dot(blended_normal, blended_normal);
    if (normal_length_sq <= normal_length_epsilon) {
        return false;
    }

    body_normal = blended_normal * inversesqrt(normal_length_sq);
    return true;
}

bool compute_contact(uvec4 pair_record, uvec3 target_vertices, out VertexFaceContact contact)
{
    if (pair_record.w != higher_vertex_lower_face_role &&
        pair_record.w != lower_vertex_higher_face_role) {
        return false;
    }

    vec3 previous_query = read_cloth_previous_position(pair_record.x);
    vec3 current_query = read_cloth_current_position(pair_record.x);
    vec3 previous_a = read_cloth_previous_position(target_vertices.x);
    vec3 previous_b = read_cloth_previous_position(target_vertices.y);
    vec3 previous_c = read_cloth_previous_position(target_vertices.z);
    vec3 current_a = read_cloth_current_position(target_vertices.x);
    vec3 current_b = read_cloth_current_position(target_vertices.y);
    vec3 current_c = read_cloth_current_position(target_vertices.z);

    vec3 previous_normal;
    vec3 current_normal;
    if (!compute_triangle_normal(previous_a, previous_b, previous_c, previous_normal) ||
        !compute_triangle_normal(current_a, current_b, current_c, current_normal)) {
        return false;
    }

    if (dot(current_normal, previous_normal) < 0.0) {
        current_normal = -current_normal;
    }

    float query_side = pair_record.w == higher_vertex_lower_face_role ? 1.0 : -1.0;
    float previous_signed_distance = dot(previous_query - previous_a, previous_normal);
    float current_signed_distance = dot(current_query - current_a, current_normal);
    float previous_distance = previous_signed_distance * query_side;
    float current_distance = current_signed_distance * query_side;

    bool has_swept_contact = false;
    float distance_delta = previous_distance - current_distance;
    if (previous_distance > uCollisionGap && distance_delta > distance_delta_epsilon) {
        float hit_time = clamp((previous_distance - uCollisionGap) / distance_delta, 0.0, 1.0);
        vec3 hit_query = mix(previous_query, current_query, hit_time);
        vec3 hit_a = mix(previous_a, current_a, hit_time);
        vec3 hit_b = mix(previous_b, current_b, hit_time);
        vec3 hit_c = mix(previous_c, current_c, hit_time);
        vec3 hit_normal;
        if (compute_triangle_normal(hit_a, hit_b, hit_c, hit_normal)) {
            if (dot(hit_normal, previous_normal) < 0.0) {
                hit_normal = -hit_normal;
            }
            vec3 hit_surface_point = hit_query - hit_normal * (uCollisionGap * query_side);
            has_swept_contact = compute_barycentric_if_inside(hit_surface_point,
                                                              hit_a,
                                                              hit_b,
                                                              hit_c,
                                                              contact.barycentric);
        }
    }

    if (!has_swept_contact) {
        vec3 current_surface_point = current_query - current_normal * current_signed_distance;
        if (!compute_barycentric_if_inside(current_surface_point,
                                           current_a,
                                           current_b,
                                           current_c,
                                           contact.barycentric)) {
            return false;
        }
    }

    vec3 current_surface_point = current_a * contact.barycentric.x +
                                 current_b * contact.barycentric.y +
                                 current_c * contact.barycentric.z;
    vec3 lower_reference_point = pair_record.w == higher_vertex_lower_face_role
        ? current_surface_point
        : current_query;
    vec3 higher_surface_point = pair_record.w == higher_vertex_lower_face_role
        ? current_query
        : current_surface_point;

    vec3 body_outward;
    if (!read_lower_body_normal(pair_record,
                                target_vertices,
                                contact.barycentric,
                                body_outward)) {
        return false;
    }

    float layer_distance = dot(higher_surface_point - lower_reference_point, body_outward);
    contact.depth = uCollisionGap - layer_distance - uPenetrationTolerance;
    if (contact.depth <= 0.0) {
        return false;
    }

    contact.correction_normal = body_outward;
    return true;
}

void accumulate_higher_vertex(uint vertex_index, VertexFaceContact contact)
{
    vec3 correction = contact.correction_normal * contact.depth * uBarrierStiffness;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void accumulate_higher_face_vertex(uint vertex_index,
                                   float vertex_weight,
                                   float inverse_denominator,
                                   VertexFaceContact contact)
{
    if (vertex_weight <= 0.0) {
        return;
    }

    float weight_scale = vertex_weight * inverse_denominator;
    vec3 correction = contact.correction_normal * contact.depth * uBarrierStiffness * weight_scale;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void main()
{
    uint pair_index = gl_GlobalInvocationID.x;
    uint active_pair_count = min(pair_count, uMaxPairCount);
    if (pair_index >= active_pair_count) {
        return;
    }

    uvec4 pair_record = pair_records[pair_index];
    uvec3 target_vertices = load_target_vertices(pair_record);
    VertexFaceContact contact;
    if (!compute_contact(pair_record, target_vertices, contact)) {
        return;
    }

    if (pair_record.w == higher_vertex_lower_face_role) {
        accumulate_higher_vertex(pair_record.x, contact);
        return;
    }

    float inverse_denominator = 1.0 / dot(contact.barycentric, contact.barycentric);
    accumulate_higher_face_vertex(target_vertices.x,
                                  contact.barycentric.x,
                                  inverse_denominator,
                                  contact);
    accumulate_higher_face_vertex(target_vertices.y,
                                  contact.barycentric.y,
                                  inverse_denominator,
                                  contact);
    accumulate_higher_face_vertex(target_vertices.z,
                                  contact.barycentric.z,
                                  inverse_denominator,
                                  contact);
}
