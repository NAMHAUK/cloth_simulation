#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = 2) readonly buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = 3) readonly buffer FrictionCorrectionSums {
    ivec4 friction_correction_sums[];
};

layout(std430, binding = 4) readonly buffer ContactMotionDeltaSums {
    ivec4 contact_motion_delta_sums[];
};

layout(std430, binding = 5) buffer ContactMotionDeltas {
    vec4 contact_motion_deltas[];
};

uniform uint uVertexCount;
uniform float uMaxCorrectionLength;
uniform float uStaticFriction;
uniform float uDynamicFriction;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_WRITE
#include "../mesh/position_io.glsl"

#define COLLISION_CORRECTION_APPLY
#define COLLISION_CORRECTION_FRICTION_APPLY
#include "common/collision_correction_common.glsl"

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    ivec4 normal_accumulated = normal_correction_sums[vertex_index];
    if (normal_accumulated.w > 0) {
        float inverse_accumulation_scale = 1.0 / (correction_fixed_point_scale * float(normal_accumulated.w));
        vec3 final_normal_correction = clamp_correction(vec3(normal_accumulated.xyz) * inverse_accumulation_scale);
        vec3 final_friction_correction = clamp_friction_correction(
            final_normal_correction,
            vec3(friction_correction_sums[vertex_index].xyz) * inverse_accumulation_scale);

        apply_position_correction(vertex_index, final_normal_correction, final_friction_correction);
    }

    ivec4 contact_motion_accumulated = contact_motion_delta_sums[vertex_index];
    if (contact_motion_accumulated.w > 0) {
        float inverse_contact_count = 1.0 / (correction_fixed_point_scale * float(contact_motion_accumulated.w));
        contact_motion_deltas[vertex_index].xyz += vec3(contact_motion_accumulated.xyz) * inverse_contact_count;
    }
}
