#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer BodyPreviousPositions {
    float body_previous_positions[];
};

layout(std430, binding = 4) readonly buffer BodyCurrentPositions {
    float body_current_positions[];
};

layout(std430, binding = 5) readonly buffer BodyVertexNormals {
    vec4 body_vertex_normals[];
};

layout(std430, binding = 6) readonly buffer PairRecords {
    uvec2 pair_records[];
};

layout(std430, binding = 7) readonly buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 8) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = 9) buffer FrictionCorrectionSums {
    ivec4 friction_correction_sums[];
};

layout(std430, binding = 10) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

uniform uint uMaxPairCount;
uniform float uCollisionThickness;

const float penetration_tolerance = 0.0005;

#define COLLISION_POSITION_IO_CLOTH_BODY_SWEEP
#include "common/collision_position_io.glsl"

#include "common/collision_geometry_common.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#define COLLISION_CORRECTION_FRICTION_ACCUMULATE
#include "common/collision_correction_common.glsl"

struct AcceptedContact {
    vec3 normal;
    vec3 barycentric;
    vec3 friction_correction;
    float depth;
};

bool compute_pair_contact(uint pair_index, out uvec3 cloth_vertices, out AcceptedContact contact)
{
    uvec2 pair_record = pair_records[pair_index];
    uint cloth_triangle_id = pair_record.x;
    uint body_vertex_id = pair_record.y;

    uint cloth_triangle_base = cloth_triangle_id * 3u;
    cloth_vertices = uvec3(cloth_triangle_indices[cloth_triangle_base],
                           cloth_triangle_indices[cloth_triangle_base + 1u],
                           cloth_triangle_indices[cloth_triangle_base + 2u]);

    vec3 previous_a = read_cloth_previous_position(cloth_vertices.x);
    vec3 previous_b = read_cloth_previous_position(cloth_vertices.y);
    vec3 previous_c = read_cloth_previous_position(cloth_vertices.z);
    vec3 current_a = read_cloth_current_position(cloth_vertices.x);
    vec3 current_b = read_cloth_current_position(cloth_vertices.y);
    vec3 current_c = read_cloth_current_position(cloth_vertices.z);

    vec3 cloth_normal;
    if (!compute_triangle_normal(current_a, current_b, current_c, cloth_normal)) {
        return false;
    }

    // Build swept body contact point
    contact.normal = body_vertex_normals[body_vertex_id].xyz;

    vec3 previous_body_contact = read_body_previous_position(body_vertex_id) + contact.normal * uCollisionThickness;
    vec3 current_body_contact = read_body_current_position(body_vertex_id) + contact.normal * uCollisionThickness;

    // Reject pairs without front-to-back crossing unless the vertex is already penetrating now.
    float previous_signed_distance = dot(previous_body_contact - previous_a, cloth_normal);
    float current_signed_distance = dot(current_body_contact - current_a, cloth_normal);

    if (current_signed_distance > 0.0) {
        return false;
    }

    if (previous_signed_distance <= 0.0) {
        if (!compute_barycentric_if_inside(current_body_contact, current_a, current_b, current_c, contact.barycentric)) {
            return false;
        }
    } else {
        float distance_delta = current_signed_distance - previous_signed_distance;
        float hit_time = -previous_signed_distance / distance_delta;

        vec3 hit_body_contact = mix(previous_body_contact, current_body_contact, hit_time);
        vec3 hit_a = mix(previous_a, current_a, hit_time);
        vec3 hit_b = mix(previous_b, current_b, hit_time);
        vec3 hit_c = mix(previous_c, current_c, hit_time);
        if (!compute_barycentric_if_inside(hit_body_contact, hit_a, hit_b, hit_c, contact.barycentric)) {
            return false;
        }
    }

    // Compute current-pose pushout depth
    vec3 current_cloth_contact = current_a * contact.barycentric.x
                               + current_b * contact.barycentric.y
                               + current_c * contact.barycentric.z;
    contact.depth = dot(current_body_contact - current_cloth_contact, contact.normal) - penetration_tolerance;
    if (contact.depth <= 0.0) {
        return false;
    }

    vec3 previous_cloth_contact = previous_a * contact.barycentric.x
                                + previous_b * contact.barycentric.y
                                + previous_c * contact.barycentric.z;
    vec3 cloth_collision_pushout = collision_pushouts[cloth_vertices.x].xyz * contact.barycentric.x
                                 + collision_pushouts[cloth_vertices.y].xyz * contact.barycentric.y
                                 + collision_pushouts[cloth_vertices.z].xyz * contact.barycentric.z;
    contact.friction_correction = compute_friction_correction(contact.normal,
                                                              current_cloth_contact - previous_cloth_contact - cloth_collision_pushout,
                                                              current_body_contact - previous_body_contact);

    return true;
}

void accumulate_contact_for_vertex(uint vertex_index, AcceptedContact contact, float vertex_weight, float inverse_denominator)
{
    if (vertex_weight <= 0.0) {
        return;
    }

    float weight_scale = vertex_weight * inverse_denominator;
    accumulate_vertex_normal_correction(vertex_index, contact.normal * contact.depth * weight_scale);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
    accumulate_vertex_friction_correction(vertex_index, contact.friction_correction * weight_scale);
}

void main()
{
    uint pair_index = gl_GlobalInvocationID.x;
    uint active_pair_count = min(pair_count, uMaxPairCount);
    if (pair_index >= active_pair_count) {
        return;
    }

    uvec3 cloth_vertices;
    AcceptedContact contact;
    if (!compute_pair_contact(pair_index, cloth_vertices, contact)) {
        return;
    }

    float inverse_denominator = 1.0 / dot(contact.barycentric, contact.barycentric);
    accumulate_contact_for_vertex(cloth_vertices.x, contact, contact.barycentric.x, inverse_denominator);
    accumulate_contact_for_vertex(cloth_vertices.y, contact, contact.barycentric.y, inverse_denominator);
    accumulate_contact_for_vertex(cloth_vertices.z, contact, contact.barycentric.z, inverse_denominator);
}
