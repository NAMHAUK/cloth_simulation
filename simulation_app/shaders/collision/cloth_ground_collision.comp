#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer CollisionStates {
    vec4 collision_states[];
};

uniform uint uVertexCount;
uniform float uFloorHeight;

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    uint position_base = vertex_index * 3u;

    float current_y = current_positions[position_base + 1u];

    if (current_y < uFloorHeight) {
        float pushout_depth = uFloorHeight - current_y;
        current_positions[position_base + 1u] = uFloorHeight;
        vec4 collision_state = collision_states[vertex_index];
        collision_state.y += pushout_depth;
        collision_states[vertex_index] = collision_state;
    }
}
