#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    vec4 current_positions[];
};

layout(std430, binding = 1) readonly buffer PreviousPositions {
    vec4 previous_positions[];
};

layout(std430, binding = 2) buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

uniform uint uVertexCount;
uniform float uFloorHeight;
uniform float uStaticFriction;
uniform float uDynamicFriction;

const float friction_epsilon = 1.0e-8;

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uVertexCount) {
        return;
    }

    float current_y = current_positions[vertex_index].y;

    if (current_y < uFloorHeight) {
        float pushout_depth = uFloorHeight - current_y;
        vec3 friction_correction = -vec3(current_positions[vertex_index].x - previous_positions[vertex_index].x,
                                         0.0,
                                         current_positions[vertex_index].z - previous_positions[vertex_index].z);
        float friction_length_sq = dot(friction_correction, friction_correction);
        vec3 final_friction_correction = vec3(0.0);
        if (pushout_depth > friction_epsilon && friction_length_sq > friction_epsilon * friction_epsilon) {
            float friction_length = sqrt(friction_length_sq);
            float static_limit = uStaticFriction * pushout_depth;
            if (friction_length <= static_limit) {
                final_friction_correction = friction_correction;
            } else {
                final_friction_correction = friction_correction * ((uDynamicFriction * pushout_depth) / friction_length);
            }
        }

        current_positions[vertex_index].x += final_friction_correction.x;
        current_positions[vertex_index].y = uFloorHeight;
        current_positions[vertex_index].z += final_friction_correction.z;
        vec3 collision_pushout = collision_pushouts[vertex_index].xyz;
        collision_pushout.y += pushout_depth;
        collision_pushouts[vertex_index] = vec4(collision_pushout, 0.0);
    }
}
