#version 430 core

layout(local_size_x = 128) in;

#include "../mesh/primitive_geometry.glsl"

// Buffer bindings
layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer Candidates {
    uvec4 candidates[];
};

layout(std430, binding = 4) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = 5) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = 6) readonly buffer BodyTriangleGeometryBuffer {
    TriangleGeometry triangle_geometry[];
};

layout(std430, binding = 7) readonly buffer ClothBodyTriangleIds {
    uint cloth_body_triangle_ids[];
};

// Uniforms
uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uCollisionStiffness;
uniform uint uBodyTriangleCount;

// Shared dependencies
#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../mesh/position_io.glsl"

#include "common/collision_geometry_common.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#include "common/collision_correction_common.glsl"

// Shader constants
const uint upper_vertex_lower_face_role = 0u;
const uint lower_vertex_upper_face_role = 1u;
const float distance_delta_epsilon = 1.0e-8;
const float normal_length_epsilon = 1.0e-12;

struct VertexFaceContact {
    vec3 correction_normal;
    vec3 barycentric;
    float depth;
};

uvec3 load_face_vertices(uvec4 candidate)
{
    uint triangle_base = candidate.y * 3u;
    return uvec3(candidate.z + collision_triangle_indices[triangle_base],
                 candidate.z + collision_triangle_indices[triangle_base + 1u],
                 candidate.z + collision_triangle_indices[triangle_base + 2u]);
}

bool read_body_normal(uint cloth_vertex_index, out vec3 body_normal)
{
    uint body_triangle_id = cloth_body_triangle_ids[cloth_vertex_index];
    if (body_triangle_id >= uBodyTriangleCount) {
        return false;
    }

    vec4 stored_normal = triangle_geometry[body_triangle_id].normal;
    if (stored_normal.w == 0.0) {
        return false;
    }

    body_normal = stored_normal.xyz;
    return true;
}

bool read_lower_body_normal(uvec4 candidate,
                            uvec3 face_vertices,
                            vec3 barycentric,
                            out vec3 body_normal)
{
    if (candidate.w == lower_vertex_upper_face_role) {
        return read_body_normal(candidate.x, body_normal);
    }

    vec3 blended_normal = vec3(0.0);
    vec3 vertex_normal;
    if (barycentric.x > 0.0 && read_body_normal(face_vertices.x, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.x;
    }
    if (barycentric.y > 0.0 && read_body_normal(face_vertices.y, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.y;
    }
    if (barycentric.z > 0.0 && read_body_normal(face_vertices.z, vertex_normal)) {
        blended_normal += vertex_normal * barycentric.z;
    }

    float normal_length_sq = dot(blended_normal, blended_normal);
    if (normal_length_sq <= normal_length_epsilon) {
        return false;
    }

    body_normal = blended_normal * inversesqrt(normal_length_sq);
    return true;
}

bool compute_candidate_contact(uvec4 candidate, uvec3 face_vertices, out VertexFaceContact contact)
{
    if (candidate.w != upper_vertex_lower_face_role &&
        candidate.w != lower_vertex_upper_face_role) {
        return false;
    }

    vec3 previous_vertex_position = read_cloth_previous_position(candidate.x);
    vec3 current_vertex_position = read_cloth_current_position(candidate.x);
    TrianglePositions previous_face = read_cloth_previous_triangle(face_vertices);
    TrianglePositions current_face = read_cloth_current_triangle(face_vertices);

    vec3 previous_normal;
    vec3 current_normal;
    if (!compute_triangle_normal(previous_face, previous_normal) ||
        !compute_triangle_normal(current_face, current_normal)) {
        return false;
    }

    if (dot(current_normal, previous_normal) < 0.0) {
        current_normal = -current_normal;
    }

    float distance_sign = candidate.w == upper_vertex_lower_face_role ? 1.0 : -1.0;
    float previous_signed_distance = dot(previous_vertex_position - previous_face.a, previous_normal);
    float current_signed_distance = dot(current_vertex_position - current_face.a, current_normal);
    float previous_distance = previous_signed_distance * distance_sign;
    float current_distance = current_signed_distance * distance_sign;

    bool has_swept_contact = false;
    float distance_delta = previous_distance - current_distance;
    if (previous_distance > uCollisionThickness && distance_delta > distance_delta_epsilon) {
        float hit_time = clamp((previous_distance - uCollisionThickness) / distance_delta, 0.0, 1.0);
        vec3 hit_vertex_position = mix(previous_vertex_position, current_vertex_position, hit_time);
        TrianglePositions hit_face = interpolate_triangle_positions(previous_face, current_face, hit_time);
        vec3 hit_normal;
        if (compute_triangle_normal(hit_face, hit_normal)) {
            if (dot(hit_normal, previous_normal) < 0.0) {
                hit_normal = -hit_normal;
            }
            vec3 hit_surface_point = hit_vertex_position - hit_normal * (uCollisionThickness * distance_sign);
            has_swept_contact = compute_barycentric_if_inside(hit_surface_point, hit_face, contact.barycentric);
        }
    }

    if (!has_swept_contact) {
        vec3 current_surface_point = current_vertex_position - current_normal * current_signed_distance;
        if (!compute_barycentric_if_inside(current_surface_point, current_face, contact.barycentric)) {
            return false;
        }
    }

    vec3 current_surface_point = interpolate_triangle_position(current_face, contact.barycentric);
    vec3 lower_reference_point = candidate.w == upper_vertex_lower_face_role
        ? current_surface_point
        : current_vertex_position;
    vec3 upper_surface_point = candidate.w == upper_vertex_lower_face_role
        ? current_vertex_position
        : current_surface_point;

    vec3 body_outward;
    if (!read_lower_body_normal(candidate,
                                face_vertices,
                                contact.barycentric,
                                body_outward)) {
        return false;
    }

    float layer_distance = dot(upper_surface_point - lower_reference_point, body_outward);
    contact.depth = uCollisionThickness - layer_distance;
    if (contact.depth <= 0.0) {
        return false;
    }

    contact.correction_normal = body_outward;
    return true;
}

void accumulate_upper_vertex(uint vertex_index, VertexFaceContact contact)
{
    vec3 correction = contact.correction_normal * contact.depth * uCollisionStiffness;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void accumulate_upper_face_vertex(uint vertex_index,
                                   float vertex_weight,
                                   float inverse_denominator,
                                   VertexFaceContact contact)
{
    if (vertex_weight <= 0.0) {
        return;
    }

    float weight_scale = vertex_weight * inverse_denominator;
    vec3 correction = contact.correction_normal * contact.depth * uCollisionStiffness * weight_scale;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
}

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    if (candidate_index >= active_candidate_count) {
        return;
    }

    uvec4 candidate = candidates[candidate_index];
    uvec3 face_vertices = load_face_vertices(candidate);
    VertexFaceContact contact;
    if (!compute_candidate_contact(candidate, face_vertices, contact)) {
        return;
    }

    if (candidate.w == upper_vertex_lower_face_role) {
        accumulate_upper_vertex(candidate.x, contact);
        return;
    }

    float inverse_denominator = 1.0 / dot(contact.barycentric, contact.barycentric);
    accumulate_upper_face_vertex(face_vertices.x,
                                  contact.barycentric.x,
                                  inverse_denominator,
                                  contact);
    accumulate_upper_face_vertex(face_vertices.y,
                                  contact.barycentric.y,
                                  inverse_denominator,
                                  contact);
    accumulate_upper_face_vertex(face_vertices.z,
                                  contact.barycentric.z,
                                  inverse_denominator,
                                  contact);
}
