#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = 3) readonly buffer BodyPreviousPositions {
    float body_previous_positions[];
};

layout(std430, binding = 4) readonly buffer BodyCurrentPositions {
    float body_current_positions[];
};

layout(std430, binding = 5) readonly buffer BodyEdgeIndices {
    uint body_edge_indices[];
};

layout(std430, binding = 6) readonly buffer PairRecords {
    uvec2 pair_records[];
};

layout(std430, binding = 7) readonly buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 8) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = 9) buffer FrictionCorrectionSums {
    ivec4 friction_correction_sums[];
};

layout(std430, binding = 10) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

uniform uint uMaxPairCount;
uniform float uCollisionThickness;

const float penetration_tolerance = 0.0005;
const float ccd_parallel_epsilon = 1.0e-8;

#define COLLISION_POSITION_IO_CLOTH_BODY_SWEEP
#include "common/collision_position_io.glsl"

#include "common/collision_geometry_common.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#define COLLISION_CORRECTION_FRICTION_ACCUMULATE
#include "common/collision_correction_common.glsl"

struct EdgeContact {
    vec3 normal;
    float cloth_t;
    vec3 friction_correction;
    float depth;
};

bool compute_pair_contact(uint pair_index, out uvec2 cloth_vertices, out EdgeContact contact)
{
    uvec2 pair_record = pair_records[pair_index];
    uint cloth_edge_base = pair_record.x * 2u;
    uint body_edge_base = pair_record.y * 2u;
    cloth_vertices = uvec2(cloth_edge_indices[cloth_edge_base],
                           cloth_edge_indices[cloth_edge_base + 1u]);
    uvec2 body_vertices = uvec2(body_edge_indices[body_edge_base],
                                body_edge_indices[body_edge_base + 1u]);

    vec3 current_cloth_a = read_cloth_current_position(cloth_vertices.x);
    vec3 current_cloth_b = read_cloth_current_position(cloth_vertices.y);
    vec3 current_body_a = read_body_current_position(body_vertices.x);
    vec3 current_body_b = read_body_current_position(body_vertices.y);

    SegmentState current_cloth_segment = SegmentState(current_cloth_a, current_cloth_b, 0.0, current_cloth_a);
    SegmentState current_body_segment = SegmentState(current_body_a, current_body_b, 0.0, current_body_a);
    if (!closest_segment_points(current_cloth_segment, current_body_segment)) {
        return false;
    }

    vec3 current_delta = current_cloth_segment.point - current_body_segment.point;
    float contact_distance = uCollisionThickness - penetration_tolerance;
    float current_distance_sq = dot(current_delta, current_delta);
    if (contact_distance <= 0.0 ||
        current_distance_sq >= contact_distance * contact_distance) {
        return false;
    }

    vec3 previous_cloth_a = read_cloth_previous_position(cloth_vertices.x);
    vec3 previous_cloth_b = read_cloth_previous_position(cloth_vertices.y);
    vec3 previous_body_a = read_body_previous_position(body_vertices.x);
    vec3 previous_body_b = read_body_previous_position(body_vertices.y);

    SegmentState previous_cloth_segment = SegmentState(previous_cloth_a, previous_cloth_b, 0.0, previous_cloth_a);
    SegmentState previous_body_segment = SegmentState(previous_body_a, previous_body_b, 0.0, previous_body_a);
    if (!closest_segment_points(previous_cloth_segment, previous_body_segment)) {
        return false;
    }

    vec3 previous_delta = previous_cloth_segment.point - previous_body_segment.point;
    float previous_distance_sq = dot(previous_delta, previous_delta);

    vec3 normal = current_delta;
    if (current_distance_sq <= ccd_parallel_epsilon) {
        if (previous_distance_sq <= ccd_parallel_epsilon) {
            return false;
        }
        normal = previous_delta * inversesqrt(previous_distance_sq);
    } else {
        normal *= inversesqrt(current_distance_sq);
    }

    float current_signed_distance = dot(current_delta, normal);
    float collision_thickness_sq = uCollisionThickness * uCollisionThickness;
    if (previous_distance_sq > collision_thickness_sq &&
        dot(previous_delta, normal) <= uCollisionThickness) {
        return false;
    }

    contact.normal = normal;
    contact.cloth_t = current_cloth_segment.t;
    vec3 cloth_collision_pushout = mix(collision_pushouts[cloth_vertices.x].xyz,
                                       collision_pushouts[cloth_vertices.y].xyz,
                                       current_cloth_segment.t);
    vec3 cloth_delta = current_cloth_segment.point
                     - mix(previous_cloth_a, previous_cloth_b, current_cloth_segment.t)
                     - cloth_collision_pushout;
    vec3 body_delta = current_body_segment.point - mix(previous_body_a, previous_body_b, current_body_segment.t);
    contact.friction_correction = compute_friction_correction(normal, cloth_delta, body_delta);
    contact.depth = uCollisionThickness - current_signed_distance - penetration_tolerance;
    return true;
}

void accumulate_contact_for_vertex(uint vertex_index,
                                   EdgeContact contact,
                                   float vertex_weight,
                                   float inverse_denominator)
{
    if (vertex_weight <= 0.0) {
        return;
    }

    vec3 correction = contact.normal * contact.depth * vertex_weight * inverse_denominator;
    accumulate_vertex_normal_correction(vertex_index, correction);
    atomicAdd(normal_correction_sums[vertex_index].w, 1);
    accumulate_vertex_friction_correction(vertex_index, contact.friction_correction * vertex_weight * inverse_denominator);
}

void main()
{
    uint pair_index = gl_GlobalInvocationID.x;
    uint active_pair_count = min(pair_count, uMaxPairCount);
    if (pair_index >= active_pair_count) {
        return;
    }

    uvec2 cloth_vertices;
    EdgeContact contact;
    if (!compute_pair_contact(pair_index, cloth_vertices, contact)) {
        return;
    }

    float weight_a = 1.0 - contact.cloth_t;
    float weight_b = contact.cloth_t;
    float inverse_denominator = 1.0 / (weight_a * weight_a + weight_b * weight_b);
    accumulate_contact_for_vertex(cloth_vertices.x, contact, weight_a, inverse_denominator);
    accumulate_contact_for_vertex(cloth_vertices.y, contact, weight_b, inverse_denominator);
}
