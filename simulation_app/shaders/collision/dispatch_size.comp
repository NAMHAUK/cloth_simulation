#version 430 core

#include "../simulation_buffer_bindings.glsl"

// Builds candidate accumulation group counts for glDispatchComputeIndirect from the detected candidate count.

layout(local_size_x = 1) in;

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATE_COUNT) readonly buffer ClothVertexBodyFaceCandidateCount {
    uint cloth_vertex_body_face_candidate_count;
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_DISPATCH_SIZE) buffer ClothVertexBodyFaceDispatchSize {
    uint cloth_vertex_body_face_dispatch_size_x;
    uint cloth_vertex_body_face_dispatch_size_y;
    uint cloth_vertex_body_face_dispatch_size_z;
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_CANDIDATE_COUNT) readonly buffer ClothEdgeBodyEdgeCandidateCount {
    uint cloth_edge_body_edge_candidate_count;
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_DISPATCH_SIZE) buffer ClothEdgeBodyEdgeDispatchSize {
    uint cloth_edge_body_edge_dispatch_size_x;
    uint cloth_edge_body_edge_dispatch_size_y;
    uint cloth_edge_body_edge_dispatch_size_z;
};

layout(std430, binding = CLOTH_FACE_BODY_VERTEX_CANDIDATE_COUNT) readonly buffer ClothFaceBodyVertexCandidateCount {
    uint cloth_face_body_vertex_candidate_count;
};

layout(std430, binding = CLOTH_FACE_BODY_VERTEX_DISPATCH_SIZE) buffer ClothFaceBodyVertexDispatchSize {
    uint cloth_face_body_vertex_dispatch_size_x;
    uint cloth_face_body_vertex_dispatch_size_y;
    uint cloth_face_body_vertex_dispatch_size_z;
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_CANDIDATE_COUNT) readonly buffer ClothClothVertexFaceCandidateCount {
    uint cloth_cloth_vertex_face_candidate_count;
};

layout(std430, binding = CLOTH_CLOTH_VERTEX_FACE_DISPATCH_SIZE) buffer ClothClothVertexFaceDispatchSize {
    uint cloth_cloth_vertex_face_dispatch_size_x;
    uint cloth_cloth_vertex_face_dispatch_size_y;
    uint cloth_cloth_vertex_face_dispatch_size_z;
};

uniform uint uMaxCandidateCount;
uniform uint uCandidateKind;

const uint candidate_accumulate_local_size = 128u;

void main()
{
    uint candidate_count;
    if (uCandidateKind == 0u) {
        candidate_count = cloth_vertex_body_face_candidate_count;
    } else if (uCandidateKind == 1u) {
        candidate_count = cloth_edge_body_edge_candidate_count;
    } else if (uCandidateKind == 2u) {
        candidate_count = cloth_face_body_vertex_candidate_count;
    } else if (uCandidateKind == 3u) {
        candidate_count = cloth_cloth_vertex_face_candidate_count;
    } else {
        return;
    }

    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    uint dispatch_size_x = (active_candidate_count + candidate_accumulate_local_size - 1u) /
                           candidate_accumulate_local_size;
    if (uCandidateKind == 0u) {
        cloth_vertex_body_face_dispatch_size_x = dispatch_size_x;
        cloth_vertex_body_face_dispatch_size_y = 1u;
        cloth_vertex_body_face_dispatch_size_z = 1u;
    } else if (uCandidateKind == 1u) {
        cloth_edge_body_edge_dispatch_size_x = dispatch_size_x;
        cloth_edge_body_edge_dispatch_size_y = 1u;
        cloth_edge_body_edge_dispatch_size_z = 1u;
    } else if (uCandidateKind == 2u) {
        cloth_face_body_vertex_dispatch_size_x = dispatch_size_x;
        cloth_face_body_vertex_dispatch_size_y = 1u;
        cloth_face_body_vertex_dispatch_size_z = 1u;
    } else {
        cloth_cloth_vertex_face_dispatch_size_x = dispatch_size_x;
        cloth_cloth_vertex_face_dispatch_size_y = 1u;
        cloth_cloth_vertex_face_dispatch_size_z = 1u;
    }
}
