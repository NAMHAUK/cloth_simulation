#version 430 core

// Builds candidate accumulation group counts for glDispatchComputeIndirect from the detected candidate count.

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = 1) buffer DispatchSize {
    uint dispatch_size_x;
    uint dispatch_size_y;
    uint dispatch_size_z;
};

uniform uint uMaxCandidateCount;
uniform uint uLocalSize;

void main()
{
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    dispatch_size_x = (active_candidate_count + uLocalSize - 1u) / uLocalSize;
    dispatch_size_y = 1u;
    dispatch_size_z = 1u;
}
