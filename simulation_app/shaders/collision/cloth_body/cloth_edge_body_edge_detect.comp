#version 430 core

#include "../../simulation_buffer_bindings.glsl"

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = STRETCH_EDGE_INDICES) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = BODY_EDGE_BOUNDS) readonly buffer BodyEdgeBounds {
    Aabb body_edge_bounds[];
};

layout(std430, binding = BODY_EDGE_BVH_NODES) readonly buffer BvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uEdgeCount;
uniform uint uMaxCandidateCount;

const uint bvh_root_node = 0u;

struct DetectionInput
{
    Aabb bounds;
    uint edge_index;
};

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node);
void detect_leaf_candidates(DetectionInput detection_input, BvhNode node);

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../detection.glsl"

Aabb build_cloth_edge_swept_aabb(uint cloth_edge_index)
{
    uint edge_base = cloth_edge_index * 2u;
    uint vertex_a = cloth_edge_indices[edge_base];
    uint vertex_b = cloth_edge_indices[edge_base + 1u];

    vec3 previous_a = read_cloth_previous_position(vertex_a);
    vec3 previous_b = read_cloth_previous_position(vertex_b);
    vec3 current_a = read_cloth_current_position(vertex_a);
    vec3 current_b = read_cloth_current_position(vertex_b);

    vec3 min_bounds = min(min(previous_a, previous_b), min(current_a, current_b));
    vec3 max_bounds = max(max(previous_a, previous_b), max(current_a, current_b));
    return Aabb(vec4(min_bounds, 0.0), vec4(max_bounds, 0.0));
}

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node)
{
    bool can_visit_left = overlaps_aabb(detection_input.bounds, bvh_nodes[node.left_child_index].bounds);
    bool can_visit_right = overlaps_aabb(detection_input.bounds, bvh_nodes[node.right_child_index].bounds);
    return bvec2(can_visit_left, can_visit_right);
}

void detect_leaf_candidates(DetectionInput detection_input, BvhNode node)
{
    for (uint edge_offset = 0u; edge_offset < node.element_count; ++edge_offset) {
        uint body_edge_index = node.first_element_index + edge_offset;
        Aabb body_bounds = body_edge_bounds[body_edge_index];
        if (overlaps_aabb(detection_input.bounds, body_bounds)) {
            append_candidate(uvec2(detection_input.edge_index, body_edge_index));
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();

    uint cloth_edge_index = gl_GlobalInvocationID.x;
    if (cloth_edge_index < uEdgeCount) {
        Aabb bounds = build_cloth_edge_swept_aabb(cloth_edge_index);
        DetectionInput detection_input = DetectionInput(bounds, cloth_edge_index);
        detect_candidates(detection_input, bvh_root_node);
    }

    flush_group_candidates();
}
