#version 430 core

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = 3) readonly buffer BodyEdgeBounds {
    Aabb body_edge_bounds[];
};

layout(std430, binding = 4) readonly buffer BvhNodes {
    BvhNode body_edge_bvh_nodes[];
};

layout(std430, binding = 7) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = 8) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uEdgeCount;
uniform uint uMaxCandidateCount;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;
const uint group_candidate_capacity = 512u;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../candidate_output.glsl"

Aabb build_cloth_edge_swept_aabb(uint cloth_edge_index)
{
    uint edge_base = cloth_edge_index * 2u;
    uint vertex_a = cloth_edge_indices[edge_base];
    uint vertex_b = cloth_edge_indices[edge_base + 1u];

    vec3 previous_a = read_cloth_previous_position(vertex_a);
    vec3 previous_b = read_cloth_previous_position(vertex_b);
    vec3 current_a = read_cloth_current_position(vertex_a);
    vec3 current_b = read_cloth_current_position(vertex_b);

    vec3 min_bounds = min(min(previous_a, previous_b), min(current_a, current_b));
    vec3 max_bounds = max(max(previous_a, previous_b), max(current_a, current_b));
    return Aabb(vec4(min_bounds, 0.0), vec4(max_bounds, 0.0));
}

Aabb build_body_edge_swept_aabb(uint body_edge_index)
{
    return body_edge_bounds[body_edge_index];
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();

    uint cloth_edge_index = gl_GlobalInvocationID.x;
    if (cloth_edge_index < uEdgeCount) {
        Aabb cloth_swept_bounds = build_cloth_edge_swept_aabb(cloth_edge_index);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = bvh_root_node;

        while (stack_count > 0u) {
            --stack_count;
            BvhNode current_node = body_edge_bvh_nodes[node_index_stack[stack_count]];
            if (!overlaps_aabb(cloth_swept_bounds, current_node.bounds)) {
                continue;
            }

            if (is_leaf_node(current_node)) {
                for (uint edge_offset = 0u; edge_offset < current_node.element_count; ++edge_offset) {
                    uint body_edge_index = current_node.first_element_index + edge_offset;
                    Aabb body_bounds = build_body_edge_swept_aabb(body_edge_index);
                    if (overlaps_aabb(cloth_swept_bounds, body_bounds)) {
                        append_candidate(uvec2(cloth_edge_index, body_edge_index));
                    }
                }
            } else {
                node_index_stack[stack_count++] = current_node.left_child_index;
                node_index_stack[stack_count++] = current_node.right_child_index;
            }
        }
    }

    flush_group_candidates();
}
