#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = STRETCH_EDGE_INDICES) readonly buffer ClothEdgeIndices {
    uint cloth_edge_indices[];
};

layout(std430, binding = CHARACTER_PREVIOUS_POSITIONS) readonly buffer BodyPreviousPositions {
    vec4 body_previous_positions[];
};

layout(std430, binding = CHARACTER_CURRENT_POSITIONS) readonly buffer BodyCurrentPositions {
    vec4 body_current_positions[];
};

layout(std430, binding = BODY_EDGE_INDICES) readonly buffer BodyEdgeIndices {
    uint body_edge_indices[];
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_CANDIDATES) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_EDGE_BODY_EDGE_CANDIDATE_COUNT) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = FRICTION_CORRECTION_SUMS) buffer FrictionCorrectionSums {
    ivec4 friction_correction_sums[];
};

layout(std430, binding = CLOTH_COLLISION_PUSHOUTS) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = CLOTH_INWARD_MOTION_CORRECTIONS) readonly buffer InwardMotionCorrections
{
    vec4 inward_motion_corrections[];
};

layout(std430, binding = INWARD_MOTION_CORRECTION_SUMS) buffer InwardMotionCorrectionSums
{
    ivec4 inward_motion_correction_sums[];
};

uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;
uniform float uStaticFriction;
uniform float uDynamicFriction;

#define CLOTH_BODY_EDGE_EDGE_CONTACT

#include "contact_correction.glsl"

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    if (candidate_index >= active_candidate_count) {
        return;
    }

    accumulate_edge_edge_collision_correction(candidates[candidate_index]);
}
