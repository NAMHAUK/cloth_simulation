#version 430 core

#include "../../simulation_buffer_bindings.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

#include "../../mesh/primitive_geometry.glsl"

layout(std430, binding = BODY_TRIANGLE_POSITIONS) readonly buffer BodyTrianglePositions {
    TrianglePositions body_triangle_positions[];
};

layout(std430, binding = BODY_TRIANGLE_NORMALS) readonly buffer BodyTriangleNormals {
    vec4 body_triangle_normals[];
};

layout(std430, binding = CHARACTER_PREVIOUS_POSITIONS) readonly buffer BodyPreviousPositions {
    vec4 body_previous_positions[];
};

layout(std430, binding = CHARACTER_TRIANGLE_INDICES) readonly buffer BodyTriangleIndices {
    uint triangle_indices[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATES) readonly buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATE_COUNT) readonly buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = NORMAL_CORRECTION_SUMS) buffer NormalCorrectionSums {
    ivec4 normal_correction_sums[];
};

layout(std430, binding = FRICTION_CORRECTION_SUMS) buffer FrictionCorrectionSums {
    ivec4 friction_correction_sums[];
};

layout(std430, binding = CLOTH_COLLISION_PUSHOUTS) readonly buffer CollisionPushouts {
    vec4 collision_pushouts[];
};

layout(std430, binding = CLOTH_INWARD_MOTION_CORRECTIONS) readonly buffer InwardMotionCorrections
{
    vec4 inward_motion_corrections[];
};

layout(std430, binding = INWARD_MOTION_CORRECTION_SUMS) buffer InwardMotionCorrectionSums
{
    ivec4 inward_motion_correction_sums[];
};

uniform uint uMaxCandidateCount;
uniform float uCollisionThickness;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#define POSITION_IO_BODY_PREVIOUS
#define POSITION_IO_TRIANGLE_INDICES
#include "../../mesh/position_io.glsl"

#include "../contact_geometry.glsl"

#define COLLISION_CORRECTION_ACCUMULATE
#define COLLISION_INWARD_MOTION_ACCUMULATE
#define COLLISION_CORRECTION_FRICTION_ACCUMULATE
#include "../correction.glsl"

struct VertexFaceContact {
    vec3 normal;
    vec3 relative_delta;
    vec3 inward_relative_delta;
    float depth;
};

bool compute_vertex_triangle_contact(uint cloth_vertex_index, uint triangle_index, out VertexFaceContact contact)
{
    vec3 face_normal = body_triangle_normals[triangle_index].xyz;
    if (dot(face_normal, face_normal) <= 1.0e-20) {
        return false;
    }

    TrianglePositions cur_triangle_pos = body_triangle_positions[triangle_index];
    TrianglePositions prev_triangle_pos = read_body_previous_triangle(read_triangle_indices(triangle_index));
    vec3 cur_vertex_pos = read_cloth_current_position(cloth_vertex_index);
    vec3 prev_vertex_pos = read_cloth_previous_position(cloth_vertex_index);

    vec3 delta_a = cur_triangle_pos.a - prev_triangle_pos.a;
    vec3 delta_b = cur_triangle_pos.b - prev_triangle_pos.b;
    vec3 delta_c = cur_triangle_pos.c - prev_triangle_pos.c;
    vec3 delta_triangle = (delta_a + delta_b + delta_c) / 3.0;
    vec3 relative_prev_vertex_pos = prev_vertex_pos + delta_triangle;

    float cur_signed_distance = dot(cur_vertex_pos - cur_triangle_pos.a, face_normal);
    float penetration_depth = uCollisionThickness - cur_signed_distance;
    if (penetration_depth <= 0.0) {
        return false;
    }

    vec3 barycentric;
    if (!find_contact_barycentric(relative_prev_vertex_pos,
                                  cur_vertex_pos,
                                  cur_triangle_pos,
                                  face_normal,
                                  cur_signed_distance,
                                  uCollisionThickness,
                                  barycentric)) {
        return false;
    }

    // collision correction calculation
    vec3 triangle_delta = delta_a * barycentric.x + delta_b * barycentric.y + delta_c * barycentric.z;
    vec3 vertex_delta = cur_vertex_pos - prev_vertex_pos - collision_pushouts[cloth_vertex_index].xyz;

    vec3 relative_delta = vertex_delta - triangle_delta;
    vec3 inward_corrected_relative_delta = relative_delta + inward_motion_corrections[cloth_vertex_index].xyz;

    contact.normal = face_normal;
    contact.depth = penetration_depth;
    contact.relative_delta = relative_delta;
    contact.inward_relative_delta = inward_corrected_relative_delta;
    return true;
}

void accumulate_contact(uint cloth_vertex_index, VertexFaceContact contact)
{
    accumulate_vertex_normal_correction(cloth_vertex_index, contact.normal, contact.depth);
    accumulate_vertex_friction_correction(cloth_vertex_index, contact.normal, contact.relative_delta);
    accumulate_vertex_inward_motion_correction(cloth_vertex_index, contact.normal, contact.inward_relative_delta, 1.0);
}

void main()
{
    uint candidate_index = gl_GlobalInvocationID.x;
    uint active_candidate_count = min(candidate_count, uMaxCandidateCount);
    if (candidate_index >= active_candidate_count) {
        return;
    }

    uvec2 candidate = candidates[candidate_index];
    VertexFaceContact contact;
    if (compute_vertex_triangle_contact(candidate.x, candidate.y, contact)) {
        accumulate_contact(candidate.x, contact);
    }
}
