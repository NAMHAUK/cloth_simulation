#version 430 core

#include "../../simulation_buffer_bindings.glsl"

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = BODY_TRIANGLE_BOUNDS) readonly buffer BodyTriangleBounds {
    Aabb body_triangle_bounds[];
};

layout(std430, binding = BODY_TRIANGLE_BVH_NODES) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uClothVertexCount;
uniform uint uMaxCandidateCount;

const uint bvh_root_node = 0u;

struct DetectionInput
{
    Aabb bounds;
    uint vertex_index;
};

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node);
void detect_leaf_candidates(DetectionInput detection_input, BvhNode node);

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../detection.glsl"

bvec2 select_children_to_visit(DetectionInput detection_input, BvhNode node)
{
    bool can_visit_left = overlaps_aabb(detection_input.bounds, bvh_nodes[node.left_child_index].bounds);
    bool can_visit_right = overlaps_aabb(detection_input.bounds, bvh_nodes[node.right_child_index].bounds);
    return bvec2(can_visit_left, can_visit_right);
}

void detect_leaf_candidates(DetectionInput detection_input, BvhNode node)
{
    for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
        uint triangle_index = node.first_element_index + triangle_offset;
        Aabb triangle_bounds = body_triangle_bounds[triangle_index];
        if (overlaps_aabb(detection_input.bounds, triangle_bounds)) {
            append_candidate(uvec2(detection_input.vertex_index, triangle_index));
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();

    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    if (cloth_vertex_index < uClothVertexCount) {
        vec3 previous_position = read_cloth_previous_position(cloth_vertex_index);
        vec3 current_position = read_cloth_current_position(cloth_vertex_index);
        Aabb bounds = build_swept_aabb(previous_position, current_position);
        DetectionInput detection_input = DetectionInput(bounds, cloth_vertex_index);
        detect_candidates(detection_input, bvh_root_node);
    }

    flush_group_candidates();
}
