#version 430 core

#include "../../simulation_buffer_bindings.glsl"

#include "../../bvh/bvh.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = CLOTH_CURRENT_POSITIONS) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = CLOTH_PREVIOUS_POSITIONS) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = BODY_TRIANGLE_BOUNDS) readonly buffer BodyTriangleBounds {
    Aabb body_triangle_bounds[];
};

layout(std430, binding = BODY_TRIANGLE_BVH_NODES) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATES) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = CLOTH_VERTEX_BODY_FACE_CANDIDATE_COUNT) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uClothVertexCount;
uniform uint uMaxCandidateCount;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;
const uint group_candidate_capacity = 512u;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../../mesh/position_io.glsl"
#include "../candidate_output.glsl"

Aabb build_swept_vertex_aabb(vec3 previous_position, vec3 current_position)
{
    return build_swept_aabb(previous_position, current_position);
}

Aabb build_body_triangle_aabb(uint triangle_index)
{
    return body_triangle_bounds[triangle_index];
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();

    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    if (cloth_vertex_index < uClothVertexCount) {
        vec3 previous_position = read_cloth_previous_position(cloth_vertex_index);
        vec3 current_position = read_cloth_current_position(cloth_vertex_index);
        Aabb query_bounds = build_swept_vertex_aabb(previous_position, current_position);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = bvh_root_node;

        while (stack_count > 0u) {
            --stack_count;
            BvhNode current_node = bvh_nodes[node_index_stack[stack_count]];
            if (!overlaps_aabb(query_bounds, current_node.bounds)) {
                continue;
            }

            if (is_leaf_node(current_node)) {
                for (uint triangle_offset = 0u; triangle_offset < current_node.element_count; ++triangle_offset) {
                    uint triangle_index = current_node.first_element_index + triangle_offset;
                    Aabb triangle_bounds = build_body_triangle_aabb(triangle_index);
                    if (overlaps_aabb(query_bounds, triangle_bounds)) {
                        append_candidate(uvec2(cloth_vertex_index, triangle_index));
                    }
                }
            } else {
                node_index_stack[stack_count++] = current_node.left_child_index;
                node_index_stack[stack_count++] = current_node.right_child_index;
            }
        }
    }

    flush_group_candidates();
}
