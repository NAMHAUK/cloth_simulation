#version 430 core

#include "../mesh/bvh_common.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer ClothTriangleBounds {
    Aabb triangle_bounds[];
};

layout(std430, binding = 4) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 5) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = 6) buffer CandidateCount {
    uint candidate_count;
};

layout(std430, binding = 7) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uUpperVertexOffset;
uniform uint uUpperVertexCount;
uniform uint uUpperTriangleOffset;
uniform uint uUpperBvhNodeOffset;
uniform uint uLowerVertexOffset;
uniform uint uLowerVertexCount;
uniform uint uLowerTriangleOffset;
uniform uint uLowerBvhNodeOffset;
uniform uint uMaxCandidateCount;

const uint max_bvh_stack_depth = 32u;
const uint group_candidate_capacity = 512u;

shared uint garment_roots_overlap;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../mesh/position_io.glsl"
#include "common/cloth_cloth_candidate_output.glsl"

bool roots_overlap()
{
    BvhNode upper_root = bvh_nodes[uUpperBvhNodeOffset];
    BvhNode lower_root = bvh_nodes[uLowerBvhNodeOffset];
    return overlaps_aabb(upper_root.bounds, lower_root.bounds);
}

void detect_vertex_face_candidates(uint cloth_vertex_index,
                              uint target_triangle_offset,
                              uint target_bvh_node_offset)
{
    vec3 previous_position = read_cloth_previous_position(cloth_vertex_index);
    vec3 current_position = read_cloth_current_position(cloth_vertex_index);
    Aabb vertex_bounds = build_swept_aabb(previous_position, current_position);

    uint node_index_stack[max_bvh_stack_depth];
    uint stack_count = 0u;
    node_index_stack[stack_count++] = 0u;

    while (stack_count > 0u) {
        uint local_node_index = node_index_stack[--stack_count];
        BvhNode node = bvh_nodes[target_bvh_node_offset + local_node_index];
        if (!overlaps_aabb(vertex_bounds, node.bounds)) {
            continue;
        }

        if (is_leaf_node(node)) {
            for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
                uint global_triangle_index = target_triangle_offset + node.first_element_index + triangle_offset;
                Aabb bounds = triangle_bounds[global_triangle_index];
                if (overlaps_aabb(vertex_bounds, bounds)) {
                    append_candidate(uvec2(cloth_vertex_index, global_triangle_index));
                }
            }
        } else {
            node_index_stack[stack_count++] = node.left_child_index;
            node_index_stack[stack_count++] = node.right_child_index;
        }
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
        garment_roots_overlap = roots_overlap() ? 1u : 0u;
    }
    barrier();

    uint dispatch_vertex_index = gl_GlobalInvocationID.x;
    uint garment_pair_vertex_count = uUpperVertexCount + uLowerVertexCount;
    
    if (garment_roots_overlap != 0u && dispatch_vertex_index < garment_pair_vertex_count) {
        bool is_upper_vertex = dispatch_vertex_index < uUpperVertexCount;
        if (is_upper_vertex) {
            detect_vertex_face_candidates(uUpperVertexOffset + dispatch_vertex_index,
                                          uLowerTriangleOffset,
                                          uLowerBvhNodeOffset);
        } else {
            uint lower_vertex_index = dispatch_vertex_index - uUpperVertexCount;
            detect_vertex_face_candidates(uLowerVertexOffset + lower_vertex_index,
                                          uUpperTriangleOffset,
                                          uUpperBvhNodeOffset);
        }
    }

    flush_group_candidates();
}
