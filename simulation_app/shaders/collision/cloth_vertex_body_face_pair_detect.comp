#version 430 core

#include "../character/body_bvh_common.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

struct BodyElementAabb {
    vec4 min_bounds;
    vec4 max_bounds;
};

layout(std430, binding = 2) readonly buffer BodyTriangleBounds {
    BodyElementAabb body_triangle_bounds[];
};

layout(std430, binding = 3) readonly buffer BvhNodeBuffer {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 4) buffer PairRecords {
    uvec2 pair_records[];
};

layout(std430, binding = 5) buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 6) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uClothVertexCount;
uniform uint uMaxPairCount;
uniform uint uIgnoredBodyPartMask;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;
const uint group_pair_capacity = 512u;

#define COLLISION_POSITION_IO_CLOTH_SWEEP
#include "common/collision_position_io.glsl"
#include "common/collision_pair_output.glsl"

Aabb build_swept_vertex_aabb(vec3 previous_position, vec3 current_position)
{
    return build_swept_aabb(previous_position, current_position);
}

Aabb build_body_triangle_aabb(uint triangle_index)
{
    BodyElementAabb bounds = body_triangle_bounds[triangle_index];
    return Aabb(bounds.min_bounds.xyz, bounds.max_bounds.xyz);
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_pair_count = 0u;
    }
    barrier();

    uint cloth_vertex_id = gl_GlobalInvocationID.x;
    if (cloth_vertex_id < uClothVertexCount) {
        vec3 previous_position = read_cloth_previous_position(cloth_vertex_id);
        vec3 current_position = read_cloth_current_position(cloth_vertex_id);
        Aabb query_bounds = build_swept_vertex_aabb(previous_position, current_position);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = bvh_root_node;

        while (stack_count > 0u) {
            --stack_count;
            BvhNode current_node = bvh_nodes[node_index_stack[stack_count]];
            if (is_ignored_body_part_node(current_node, uIgnoredBodyPartMask)) {
                continue;
            }

            if (!overlaps_aabb(query_bounds, current_node.min_bounds.xyz, current_node.max_bounds.xyz)) {
                continue;
            }

            if (is_leaf_node(current_node)) {
                for (uint triangle_offset = 0u; triangle_offset < current_node.element_count; ++triangle_offset) {
                    uint triangle_index = current_node.first_element_index + triangle_offset;
                    if (body_triangle_bounds[triangle_index].max_bounds.w == 0.0) {
                        continue;
                    }

                    Aabb triangle_bounds = build_body_triangle_aabb(triangle_index);
                    if (overlaps_aabb(query_bounds, triangle_bounds.min_bounds, triangle_bounds.max_bounds)) {
                        append_pair(uvec2(cloth_vertex_id, triangle_index));
                    }
                }
            } else {
                node_index_stack[stack_count++] = current_node.left_child_index;
                node_index_stack[stack_count++] = current_node.right_child_index;
            }
        }
    }

    flush_group_pairs();
}
