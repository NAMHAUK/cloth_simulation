#version 430 core

#include "../character/body_bvh_common.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

struct BvhBounds {
    vec4 min_bounds;
    vec4 max_bounds;
};

layout(std430, binding = 3) readonly buffer ClothTriangleBounds {
    BvhBounds triangle_bounds[];
};

layout(std430, binding = 4) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 5) buffer PairRecords {
    uvec4 pair_records[];
};

layout(std430, binding = 6) buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 7) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uQueryVertexOffset;
uniform uint uQueryVertexCount;
uniform uint uQueryBvhNodeOffset;
uniform uint uTargetVertexOffset;
uniform uint uTargetTriangleOffset;
uniform uint uTargetBvhNodeOffset;
uniform uint uQueryRole;
uniform uint uMaxPairCount;

const uint max_bvh_stack_depth = 32u;
const uint group_pair_capacity = 512u;

shared uint garment_roots_overlap;

#define COLLISION_POSITION_IO_CLOTH_SWEEP
#include "common/collision_position_io.glsl"
#include "common/cloth_cloth_pair_output.glsl"

bool roots_overlap()
{
    BvhNode query_root = bvh_nodes[uQueryBvhNodeOffset];
    BvhNode target_root = bvh_nodes[uTargetBvhNodeOffset];
    return overlaps_aabb(Aabb(query_root.min_bounds.xyz, query_root.max_bounds.xyz),
                         target_root.min_bounds.xyz,
                         target_root.max_bounds.xyz);
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_pair_count = 0u;
        garment_roots_overlap = roots_overlap() ? 1u : 0u;
    }
    barrier();

    uint local_query_vertex = gl_GlobalInvocationID.x;
    if (garment_roots_overlap != 0u && local_query_vertex < uQueryVertexCount) {
        uint query_vertex = uQueryVertexOffset + local_query_vertex;
        vec3 previous_position = read_cloth_previous_position(query_vertex);
        vec3 current_position = read_cloth_current_position(query_vertex);
        Aabb query_bounds = build_swept_aabb(previous_position, current_position);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = 0u;

        while (stack_count > 0u) {
            uint local_node_index = node_index_stack[--stack_count];
            BvhNode node = bvh_nodes[uTargetBvhNodeOffset + local_node_index];
            if (!overlaps_aabb(query_bounds, node.min_bounds.xyz, node.max_bounds.xyz)) {
                continue;
            }

            if (is_leaf_node(node)) {
                for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
                    uint packed_triangle = uTargetTriangleOffset + node.first_element_index + triangle_offset;
                    BvhBounds bounds = triangle_bounds[packed_triangle];
                    if (overlaps_aabb(query_bounds, bounds.min_bounds.xyz, bounds.max_bounds.xyz)) {
                        append_pair(uvec4(query_vertex,
                                         packed_triangle,
                                         uTargetVertexOffset,
                                         uQueryRole));
                    }
                }
            } else {
                node_index_stack[stack_count++] = node.left_child_index;
                node_index_stack[stack_count++] = node.right_child_index;
            }
        }
    }

    flush_group_pairs();
}
