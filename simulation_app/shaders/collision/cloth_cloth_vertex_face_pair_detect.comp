#version 430 core

#include "../mesh/bvh_common.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    float cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    float cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer CollisionTriangleIndices {
    uint collision_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer ClothTriangleBounds {
    Aabb triangle_bounds[];
};

layout(std430, binding = 4) readonly buffer ClothBvhNodes {
    BvhNode bvh_nodes[];
};

layout(std430, binding = 5) buffer PairRecords {
    uvec4 pair_records[];
};

layout(std430, binding = 6) buffer PairCount {
    uint pair_count;
};

layout(std430, binding = 7) buffer OverflowCount {
    uint overflow_count;
};

uniform uint uHigherVertexOffset;
uniform uint uHigherVertexCount;
uniform uint uHigherTriangleOffset;
uniform uint uHigherBvhNodeOffset;
uniform uint uLowerVertexOffset;
uniform uint uLowerVertexCount;
uniform uint uLowerTriangleOffset;
uniform uint uLowerBvhNodeOffset;
uniform uint uMaxPairCount;

const uint max_bvh_stack_depth = 32u;
const uint group_pair_capacity = 512u;
const uint higher_vertex_lower_face_role = 0u;
const uint lower_vertex_higher_face_role = 1u;

shared uint garment_roots_overlap;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../mesh/position_io.glsl"
#include "common/cloth_cloth_pair_output.glsl"

bool roots_overlap()
{
    BvhNode higher_root = bvh_nodes[uHigherBvhNodeOffset];
    BvhNode lower_root = bvh_nodes[uLowerBvhNodeOffset];
    return overlaps_aabb(Aabb(higher_root.min_bounds, higher_root.max_bounds),
                         lower_root.min_bounds,
                         lower_root.max_bounds);
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_pair_count = 0u;
        garment_roots_overlap = roots_overlap() ? 1u : 0u;
    }
    barrier();

    uint combined_query_vertex = gl_GlobalInvocationID.x;
    uint query_vertex_count = uHigherVertexCount + uLowerVertexCount;
    if (garment_roots_overlap != 0u && combined_query_vertex < query_vertex_count) {
        bool is_higher_query = combined_query_vertex < uHigherVertexCount;
        uint local_query_vertex = is_higher_query
            ? combined_query_vertex
            : combined_query_vertex - uHigherVertexCount;
        uint query_vertex_offset = is_higher_query ? uHigherVertexOffset : uLowerVertexOffset;
        uint target_vertex_offset = is_higher_query ? uLowerVertexOffset : uHigherVertexOffset;
        uint target_triangle_offset = is_higher_query ? uLowerTriangleOffset : uHigherTriangleOffset;
        uint target_bvh_node_offset = is_higher_query ? uLowerBvhNodeOffset : uHigherBvhNodeOffset;
        uint query_role = is_higher_query
            ? higher_vertex_lower_face_role
            : lower_vertex_higher_face_role;

        uint query_vertex = query_vertex_offset + local_query_vertex;
        vec3 previous_position = read_cloth_previous_position(query_vertex);
        vec3 current_position = read_cloth_current_position(query_vertex);
        Aabb query_bounds = build_swept_aabb(previous_position, current_position);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = 0u;

        while (stack_count > 0u) {
            uint local_node_index = node_index_stack[--stack_count];
            BvhNode node = bvh_nodes[target_bvh_node_offset + local_node_index];
            if (!overlaps_aabb(query_bounds, node.min_bounds, node.max_bounds)) {
                continue;
            }

            if (is_leaf_node(node)) {
                for (uint triangle_offset = 0u; triangle_offset < node.element_count; ++triangle_offset) {
                    uint packed_triangle = target_triangle_offset + node.first_element_index + triangle_offset;
                    Aabb bounds = triangle_bounds[packed_triangle];
                    if (overlaps_aabb(query_bounds, bounds.min_bounds, bounds.max_bounds)) {
                        append_pair(uvec4(query_vertex,
                                         packed_triangle,
                                         target_vertex_offset,
                                         query_role));
                    }
                }
            } else {
                node_index_stack[stack_count++] = node.left_child_index;
                node_index_stack[stack_count++] = node.right_child_index;
            }
        }
    }

    flush_group_pairs();
}
