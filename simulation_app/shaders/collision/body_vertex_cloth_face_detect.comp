#version 430 core

#include "../mesh/bvh_common.glsl"

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer ClothCurrentPositions {
    vec4 cloth_current_positions[];
};

layout(std430, binding = 1) readonly buffer ClothPreviousPositions {
    vec4 cloth_previous_positions[];
};

layout(std430, binding = 2) readonly buffer ClothTriangleIndices {
    uint cloth_triangle_indices[];
};

layout(std430, binding = 3) readonly buffer BodyVertexIndices {
    uint body_vertex_indices[];
};

layout(std430, binding = 4) readonly buffer BvhNodes {
    BvhNode body_vertex_bvh_nodes[];
};

layout(std430, binding = 5) readonly buffer BodyVertexBounds {
    Aabb body_vertex_bounds[];
};

layout(std430, binding = 7) buffer Candidates {
    uvec2 candidates[];
};

layout(std430, binding = 8) buffer CandidateCount {
    uint candidate_count;
};

uniform uint uTriangleCount;
uniform uint uMaxCandidateCount;

const uint max_bvh_stack_depth = 32u;
const uint bvh_root_node = 0u;
const uint group_candidate_capacity = 512u;

#define POSITION_IO_CLOTH_CURRENT
#define POSITION_IO_CLOTH_PREVIOUS
#include "../mesh/position_io.glsl"
#include "common/collision_candidate_output.glsl"

Aabb build_cloth_triangle_swept_aabb(uint cloth_triangle_index)
{
    uint cloth_triangle_base = cloth_triangle_index * 3u;
    uint cloth_vertex_a = cloth_triangle_indices[cloth_triangle_base];
    uint cloth_vertex_b = cloth_triangle_indices[cloth_triangle_base + 1u];
    uint cloth_vertex_c = cloth_triangle_indices[cloth_triangle_base + 2u];

    vec3 previous_a = read_cloth_previous_position(cloth_vertex_a);
    vec3 previous_b = read_cloth_previous_position(cloth_vertex_b);
    vec3 previous_c = read_cloth_previous_position(cloth_vertex_c);
    vec3 current_a = read_cloth_current_position(cloth_vertex_a);
    vec3 current_b = read_cloth_current_position(cloth_vertex_b);
    vec3 current_c = read_cloth_current_position(cloth_vertex_c);

    vec3 min_bounds = min(min(previous_a, min(previous_b, previous_c)),
                          min(current_a, min(current_b, current_c)));
    vec3 max_bounds = max(max(previous_a, max(previous_b, previous_c)),
                          max(current_a, max(current_b, current_c)));
    return Aabb(vec4(min_bounds, 0.0), vec4(max_bounds, 0.0));
}

Aabb build_body_vertex_swept_aabb(uint body_vertex_index)
{
    return body_vertex_bounds[body_vertex_index];
}

void main()
{
    if (gl_LocalInvocationIndex == 0u) {
        group_candidate_count = 0u;
    }
    barrier();

    uint cloth_triangle_index = gl_GlobalInvocationID.x;
    if (cloth_triangle_index < uTriangleCount) {
        Aabb cloth_swept_bounds = build_cloth_triangle_swept_aabb(cloth_triangle_index);

        uint node_index_stack[max_bvh_stack_depth];
        uint stack_count = 0u;
        node_index_stack[stack_count++] = bvh_root_node;

        while (stack_count > 0u) {
            --stack_count;
            uint current_node_index = node_index_stack[stack_count];
            BvhNode current_node = body_vertex_bvh_nodes[current_node_index];
            if (!overlaps_aabb(cloth_swept_bounds, current_node.bounds)) {
                continue;
            }

            if (is_leaf_node(current_node)) {
                for (uint vertex_offset = 0u; vertex_offset < current_node.element_count; ++vertex_offset) {
                    uint body_vertex_index = body_vertex_indices[current_node.first_element_index + vertex_offset];
                    Aabb body_bounds = build_body_vertex_swept_aabb(body_vertex_index);
                    if (!overlaps_aabb(cloth_swept_bounds, body_bounds)) {
                        continue;
                    }

                    append_candidate(uvec2(cloth_triangle_index, body_vertex_index));
                }
            } else {
                node_index_stack[stack_count++] = current_node.left_child_index;
                node_index_stack[stack_count++] = current_node.right_child_index;
            }
        }
    }

    flush_group_candidates();
}
