#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

layout(std430, binding = 2) readonly buffer CharacterPositions {
    float character_positions[];
};

layout(std430, binding = 3) readonly buffer CharacterIndices {
    uint character_indices[];
};

uniform uint uClothVertexCount;
uniform uint uCharacterTriangleCount;
uniform uint uCharacterPositionComponentOffset;
uniform float uCollisionThickness;

const uint tile_size = 128u;
const float epsilon = 1.0e-12;

shared vec4 tile_triangle_a[tile_size];
shared vec4 tile_triangle_b[tile_size];
shared vec4 tile_triangle_c[tile_size];
shared vec4 tile_triangle_normal[tile_size];

float length_squared(vec3 value)
{
    return dot(value, value);
}

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    current_positions[base] = position.x;
    current_positions[base + 1u] = position.y;
    current_positions[base + 2u] = position.z;
    previous_positions[base] = position.x;
    previous_positions[base + 1u] = position.y;
    previous_positions[base + 2u] = position.z;
}

vec3 load_character_position(uint vertex_index)
{
    uint base = uCharacterPositionComponentOffset + vertex_index * 3u;
    return vec3(character_positions[base], character_positions[base + 1u], character_positions[base + 2u]);
}

vec3 closest_point_on_triangle(vec3 point, vec3 a, vec3 b, vec3 c)
{
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 ap = point - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return a;
    }

    vec3 bp = point - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return b;
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        return a + v * ab;
    }

    vec3 cp = point - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return c;
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        return a + w * ac;
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + w * (c - b);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return a + ab * v + ac * w;
}

void load_character_triangle_tile(uint tile_start, uint local_index)
{
    uint triangle_index = tile_start + local_index;
    if (triangle_index >= uCharacterTriangleCount) {
        tile_triangle_a[local_index] = vec4(0.0);
        tile_triangle_b[local_index] = vec4(0.0);
        tile_triangle_c[local_index] = vec4(0.0);
        tile_triangle_normal[local_index] = vec4(0.0);
        return;
    }

    uint index_base = triangle_index * 3u;
    vec3 a = load_character_position(character_indices[index_base]);
    vec3 b = load_character_position(character_indices[index_base + 1u]);
    vec3 c = load_character_position(character_indices[index_base + 2u]);
    vec3 normal = cross(b - a, c - a);
    float normal_length_sq = length_squared(normal);

    tile_triangle_a[local_index] = vec4(a, 0.0);
    tile_triangle_b[local_index] = vec4(b, 0.0);
    tile_triangle_c[local_index] = vec4(c, 0.0);
    tile_triangle_normal[local_index] = normal_length_sq > epsilon
        ? vec4(normal * inversesqrt(normal_length_sq), 1.0)
        : vec4(0.0);
}

void main()
{
    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    uint local_index = gl_LocalInvocationID.x;
    bool is_active_thread = cloth_vertex_index < uClothVertexCount &&
                            uCharacterTriangleCount > 0u &&
                            uCollisionThickness > 0.0;

    vec3 cloth_position = is_active_thread ? load_cloth_position(cloth_vertex_index) : vec3(0.0);
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = 3.402823e+38;
    bool has_candidate = false;

    for (uint tile_start = 0u; tile_start < uCharacterTriangleCount; tile_start += tile_size) {
        load_character_triangle_tile(tile_start, local_index);
        barrier();

        if (is_active_thread) {
            uint remaining_triangle_count = uCharacterTriangleCount - tile_start;
            uint tile_triangle_count = min(tile_size, remaining_triangle_count);
            for (uint tile_index = 0u; tile_index < tile_triangle_count; ++tile_index) {
                vec4 normal_and_valid = tile_triangle_normal[tile_index];
                if (normal_and_valid.w == 0.0) {
                    continue;
                }

                vec3 a = tile_triangle_a[tile_index].xyz;
                vec3 b = tile_triangle_b[tile_index].xyz;
                vec3 c = tile_triangle_c[tile_index].xyz;
                vec3 closest_point = closest_point_on_triangle(cloth_position, a, b, c);
                vec3 offset = cloth_position - closest_point;
                float distance_sq = length_squared(offset);

                if (distance_sq < best_distance_sq) {
                    best_distance_sq = distance_sq;
                    best_closest_point = closest_point;
                    best_normal = normal_and_valid.xyz;
                    has_candidate = true;
                }
            }
        }

        barrier();
    }

    if (!is_active_thread || !has_candidate) {
        return;
    }

    float collision_thickness_sq = uCollisionThickness * uCollisionThickness;
    if (best_distance_sq > collision_thickness_sq) {
        return;
    }

    float signed_distance = dot(cloth_position - best_closest_point, best_normal);
    if (signed_distance < uCollisionThickness) {
        store_cloth_position(cloth_vertex_index, best_closest_point + best_normal * uCollisionThickness);
    }
}
