#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 face_normal;
    vec4 unit_face_normal;
};

struct MeshBvhNode {
    vec4 min_bounds;
    vec4 max_bounds;
    uvec4 metadata;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

layout(std430, binding = 3) readonly buffer MeshBvhNodeBuffer {
    MeshBvhNode bvh_nodes[];
};

uniform uint uClothVertexCount;
uniform uint uBvhNodeCount;
uniform uint uRootNodeIndex;
uniform float uCollisionThickness;

float length_squared(vec3 value)
{
    return dot(value, value);
}

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    current_positions[base] = position.x;
    current_positions[base + 1u] = position.y;
    current_positions[base + 2u] = position.z;
    previous_positions[base] = position.x;
    previous_positions[base + 1u] = position.y;
    previous_positions[base + 2u] = position.z;
}

float squared_distance_to_bounds(vec3 point, vec3 min_bounds, vec3 max_bounds)
{
    vec3 clamped_point = clamp(point, min_bounds, max_bounds);
    return length_squared(point - clamped_point);
}

vec3 closest_point_on_triangle(vec3 point, vec3 a, vec3 b, vec3 c, vec3 ab, vec3 ac)
{
    vec3 ap = point - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return a;
    }

    vec3 bp = point - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return b;
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        return a + v * ab;
    }

    vec3 cp = point - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return c;
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        return a + w * ac;
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + w * (ac - ab);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return a + ab * v + ac * w;
}

void test_character_triangle(uint triangle_index,
                             vec3 cloth_position,
                             float collision_thickness_sq,
                             inout vec3 best_closest_point,
                             inout vec3 best_normal,
                             inout float best_distance_sq,
                             inout bool has_candidate)
{
    vec4 unit_face_normal = triangle_geometry[triangle_index].unit_face_normal;
    if (unit_face_normal.w == 0.0) {
        return;
    }

    vec3 a = triangle_geometry[triangle_index].a.xyz;
    vec3 b = triangle_geometry[triangle_index].b.xyz;
    vec3 c = triangle_geometry[triangle_index].c.xyz;
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 unit_normal = unit_face_normal.xyz;

    float plane_distance = dot(cloth_position - a, unit_normal);
    if (plane_distance * plane_distance > collision_thickness_sq) {
        return;
    }

    vec3 closest_point = closest_point_on_triangle(cloth_position, a, b, c, ab, ac);
    vec3 offset = cloth_position - closest_point;
    float distance_sq = length_squared(offset);

    if (distance_sq < best_distance_sq) {
        best_distance_sq = distance_sq;
        best_closest_point = closest_point;
        best_normal = unit_normal;
        has_candidate = true;
    }
}

void main()
{
    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    if (cloth_vertex_index >= uClothVertexCount) {
        return;
    }

    vec3 cloth_position = load_cloth_position(cloth_vertex_index);
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = 3.402823e+38;
    bool has_candidate = false;
    float collision_thickness_sq = uCollisionThickness * uCollisionThickness;

    uint node_index = uRootNodeIndex;
    while (node_index < uBvhNodeCount) {
        MeshBvhNode node = bvh_nodes[node_index];
        uint next_node = node.metadata.z;
        float search_radius_sq = has_candidate ? min(best_distance_sq, collision_thickness_sq) : collision_thickness_sq;
        if (squared_distance_to_bounds(cloth_position, node.min_bounds.xyz, node.max_bounds.xyz) > search_radius_sq) {
            node_index = next_node;
            continue;
        }

        if (node.metadata.w > 0u) {
            uint first_triangle = node.metadata.x;
            uint triangle_count = node.metadata.y;
            for (uint triangle_offset = 0u; triangle_offset < triangle_count; ++triangle_offset) {
                test_character_triangle(first_triangle + triangle_offset,
                                        cloth_position,
                                        collision_thickness_sq,
                                        best_closest_point,
                                        best_normal,
                                        best_distance_sq,
                                        has_candidate);
            }
            node_index = next_node;
            continue;
        }

        uint left_child = node.metadata.x;
        uint right_child = node.metadata.y;
        if (left_child < uBvhNodeCount) {
            node_index = left_child;
        } else if (right_child < uBvhNodeCount) {
            node_index = right_child;
        } else {
            node_index = next_node;
        }
    }

    if (!has_candidate || best_distance_sq > collision_thickness_sq) {
        return;
    }

    float signed_distance = dot(cloth_position - best_closest_point, best_normal);
    if (signed_distance < uCollisionThickness) {
        store_cloth_position(cloth_vertex_index, best_closest_point + best_normal * uCollisionThickness);
    }
}
