#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer CurrentPositions {
    float current_positions[];
};

layout(std430, binding = 1) buffer PreviousPositions {
    float previous_positions[];
};

struct CharacterTriangleGeometry {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 face_normal;
    vec4 unit_face_normal;
};

layout(std430, binding = 2) readonly buffer CharacterTriangleGeometryBuffer {
    CharacterTriangleGeometry triangle_geometry[];
};

uniform uint uClothVertexCount;
uniform uint uCharacterTriangleCount;
uniform float uCollisionThickness;

const uint triangle_batch_size = 128u;

shared vec4 triangle_batch_a[triangle_batch_size];
shared vec4 triangle_batch_b[triangle_batch_size];
shared vec4 triangle_batch_c[triangle_batch_size];
shared vec4 triangle_batch_ab[triangle_batch_size];
shared vec4 triangle_batch_ac[triangle_batch_size];
shared vec4 triangle_batch_unit_normal[triangle_batch_size];

float length_squared(vec3 value)
{
    return dot(value, value);
}

vec3 load_cloth_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(current_positions[base], current_positions[base + 1u], current_positions[base + 2u]);
}

void store_cloth_position(uint vertex_index, vec3 position)
{
    uint base = vertex_index * 3u;
    current_positions[base] = position.x;
    current_positions[base + 1u] = position.y;
    current_positions[base + 2u] = position.z;
    previous_positions[base] = position.x;
    previous_positions[base + 1u] = position.y;
    previous_positions[base + 2u] = position.z;
}

vec3 closest_point_on_triangle(vec3 point, vec3 a, vec3 b, vec3 c, vec3 ab, vec3 ac)
{
    vec3 ap = point - a;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return a;
    }

    vec3 bp = point - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return b;
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        return a + v * ab;
    }

    vec3 cp = point - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return c;
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        return a + w * ac;
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        return b + w * (ac - ab);
    }

    float denom = 1.0 / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return a + ab * v + ac * w;
}

void load_character_triangle_batch(uint triangle_batch_start, uint local_index)
{
    uint triangle_index = triangle_batch_start + local_index;
    if (triangle_index >= uCharacterTriangleCount) {
        triangle_batch_a[local_index] = vec4(0.0);
        triangle_batch_b[local_index] = vec4(0.0);
        triangle_batch_c[local_index] = vec4(0.0);
        triangle_batch_ab[local_index] = vec4(0.0);
        triangle_batch_ac[local_index] = vec4(0.0);
        triangle_batch_unit_normal[local_index] = vec4(0.0);
        return;
    }

    CharacterTriangleGeometry triangle = triangle_geometry[triangle_index];
    triangle_batch_a[local_index] = triangle.a;
    triangle_batch_b[local_index] = triangle.b;
    triangle_batch_c[local_index] = triangle.c;
    triangle_batch_ab[local_index] = vec4(triangle.b.xyz - triangle.a.xyz, 0.0);
    triangle_batch_ac[local_index] = vec4(triangle.c.xyz - triangle.a.xyz, 0.0);
    triangle_batch_unit_normal[local_index] = triangle.unit_face_normal;
}

void main()
{
    uint cloth_vertex_index = gl_GlobalInvocationID.x;
    uint local_index = gl_LocalInvocationID.x;
    bool is_active_thread = cloth_vertex_index < uClothVertexCount &&
                            uCharacterTriangleCount > 0u &&
                            uCollisionThickness > 0.0;

    vec3 cloth_position = is_active_thread ? load_cloth_position(cloth_vertex_index) : vec3(0.0);
    vec3 best_closest_point = vec3(0.0);
    vec3 best_normal = vec3(0.0, 1.0, 0.0);
    float best_distance_sq = 3.402823e+38;
    bool has_candidate = false;
    float collision_thickness_sq = uCollisionThickness * uCollisionThickness;

    for (uint triangle_batch_start = 0u; triangle_batch_start < uCharacterTriangleCount; triangle_batch_start += triangle_batch_size) {
        load_character_triangle_batch(triangle_batch_start, local_index);
        barrier();

        if (is_active_thread) {
            uint remaining_triangle_count = uCharacterTriangleCount - triangle_batch_start;
            uint triangle_batch_count = min(triangle_batch_size, remaining_triangle_count);
            for (uint triangle_batch_index = 0u; triangle_batch_index < triangle_batch_count; ++triangle_batch_index) {
                vec4 unit_normal_and_valid = triangle_batch_unit_normal[triangle_batch_index];
                if (unit_normal_and_valid.w == 0.0) {
                    continue;
                }

                vec3 a = triangle_batch_a[triangle_batch_index].xyz;
                vec3 b = triangle_batch_b[triangle_batch_index].xyz;
                vec3 c = triangle_batch_c[triangle_batch_index].xyz;
                vec3 ab = triangle_batch_ab[triangle_batch_index].xyz;
                vec3 ac = triangle_batch_ac[triangle_batch_index].xyz;
                vec3 unit_normal = unit_normal_and_valid.xyz;
                float plane_distance = dot(cloth_position - a, unit_normal);
                if (plane_distance * plane_distance > collision_thickness_sq) {
                    continue;
                }

                vec3 closest_point = closest_point_on_triangle(cloth_position, a, b, c, ab, ac);
                vec3 offset = cloth_position - closest_point;
                float distance_sq = length_squared(offset);

                if (distance_sq < best_distance_sq) {
                    best_distance_sq = distance_sq;
                    best_closest_point = closest_point;
                    best_normal = unit_normal;
                    has_candidate = true;
                }
            }
        }

        barrier();
    }

    if (!is_active_thread || !has_candidate) {
        return;
    }

    if (best_distance_sq > collision_thickness_sq) {
        return;
    }

    float signed_distance = dot(cloth_position - best_closest_point, best_normal);
    if (signed_distance < uCollisionThickness) {
        store_cloth_position(cloth_vertex_index, best_closest_point + best_normal * uCollisionThickness);
    }
}
