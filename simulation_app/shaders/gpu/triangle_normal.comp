#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Positions {
    float positions[];
};

layout(std430, binding = 1) readonly buffer Indices {
    uint indices[];
};

layout(std430, binding = 2) writeonly buffer TriangleNormals {
    vec4 triangle_normals[];
};

uniform uint uTriangleCount;
uniform uint uPositionComponentOffset;

vec3 triangle_normal(vec3 p0, vec3 p1, vec3 p2)
{
    vec3 normal = cross(p1 - p0, p2 - p0);
    return dot(normal, normal) > 1.0e-20 ? normal : vec3(0.0);
}

void main()
{
    uint triangle_index = gl_GlobalInvocationID.x;
    if (triangle_index >= uTriangleCount) {
        return;
    }

    uint index_base = triangle_index * 3u;
    uint i0 = indices[index_base];
    uint i1 = indices[index_base + 1u];
    uint i2 = indices[index_base + 2u];

    uint p0_base = uPositionComponentOffset + i0 * 3u;
    uint p1_base = uPositionComponentOffset + i1 * 3u;
    uint p2_base = uPositionComponentOffset + i2 * 3u;

    vec3 p0 = vec3(positions[p0_base], positions[p0_base + 1u], positions[p0_base + 2u]);
    vec3 p1 = vec3(positions[p1_base], positions[p1_base + 1u], positions[p1_base + 2u]);
    vec3 p2 = vec3(positions[p2_base], positions[p2_base + 1u], positions[p2_base + 2u]);

    triangle_normals[triangle_index] = vec4(triangle_normal(p0, p1, p2), 0.0);
}
